<?xml version="1.0" encoding="UTF-8"?>
<SActionScript version="1" name="sampler_routing_cycle_link">

  <!-- QBX-269: A LINK THAT CLOSES A CYCLE THROUGH A ROUTING EDGE IS REFUSED
       WHEN IT IS MADE.

       The premise, measured first (the positive control of section A): an
       asset over a RETURN track bounces what the return taps, its source's
       aux bus, which lies OUTSIDE the asset's container. A probe sampler that
       links such an asset plays the Drums sampler's kick (RMS of
       ../test_clipsaw.wav, 0.5485, inside the kick window; silence before
       it). So a sampler that links an asset holding a return of its own aux
       output renders itself into its own sample: before QBX-269 that link was
       accepted and the layer re-bounced itself for ever (measured: one new
       generation per 2 s of idle and one per render, `rendering` never 0).

       Three shapes, each refused at set-layer with the hops in its line, the
       layer untouched (src, generation, renders):
         A  an asset over a return of Drums' aux 1 (an AUX edge);
         B  an asset over a track whose duck is keyed from Drums (a KEY edge);
         C  an asset over a track keyed from a send lane that Drums sends to
            (a KEY edge, then a SEND edge).
         E  as C, through a DISABLED tap (an edge the model holds, which
            set-send can enable without asking the walk);
       and one that is NOT a cycle, accepted: D, an asset over a track that
       SENDS to a lane Drums also sends to (a send feeds the send lane, not
       the sender's own output, which is all the bounce hears).
       Positive controls: the probe sampler, on a track no asset holds, links
       all three (A also carries the link's undo and redo); and once the
       return is unrouted, Drums may link the same asset, which then bounces
       ONCE and stays put (no self-bounce).

       Ids: add-zone gives each program zone 1 / layer 2, then zone 3 / layer 4.
       Zone 5 / layer 6 on Drums serves E and D.
       Tracks: 0 Drums, 1 Drums Aux 1 (the return), 2 Probe, 3 Bass, 4 Gate,
       5 Gate2, 6 Out. -->

  <setup project="new"/>

  <actions>
    <!-- ======================= Drums: the kick on aux 1, a free layer on key 60 -->
    <add-track index="-1"/>
    <set-track-name trackPath="0" name="Drums"/>
    <insert-plugin trackPath="0" slotIndex="0"
                   format="tw" uid="tw.native.nassaudigital"
                   name="NassauDigital" vendor="Nassau"
                   path="" nIn="0" nOut="2"/>
    <insert-midi-clip trackPath="0" timePos="0" duration="7680" name="Kick"/>
    <add-note clip="0,0" tick="960" dur="480" key="36" velocity="127" channel="0"/>
    <add-zone trackPath="0" slotIndex="0" keyLo="36" keyHi="36" rootKey="36"
              mode="oneshot" output="aux1">
      <layer src="file:../test_clipsaw.wav"/>
    </add-zone>
    <add-zone trackPath="0" slotIndex="0" keyLo="60" keyHi="60" rootKey="60" mode="oneshot">
      <layer src="test:none"/>
    </add-zone>
    <wait-sampler-generations trackPath="0" slotIndex="0" timeoutMs="15000"/>

    <!-- ================================================= A: the AUX edge -->
    <add-return-track trackPath="0" slot="0" bus="1"/>
    <assert-return-track trackPath="1" isReturn="1" source="0" slot="0" bus="1" routed="1"/>
    <set-track-mute trackPath="1" muted="1"/>
    <create-asset container="1" startOffset="0" duration="144000" assetName="Ret"/>

    <set-layer trackPath="0" slotIndex="0" layer="4" src="asset:Ret" expectReject="true"/>
    <assert-log contains="asset &quot;Ret&quot; contains this sampler's own track &quot;Drums&quot; (the return &quot;Drums Aux 1&quot; taps &quot;Drums&quot;)"
                minCount="1" maxCount="1"/>
    <assert-sampler-program trackPath="0" slotIndex="0" zoneIds="1;3"
                            scope="layer" id="4" attr="src" value="test:none"/>
    <assert-sampler-layer trackPath="0" slotIndex="0" layer="4" generation="0"
                          rendering="0" renders="0"/>

    <!-- The POSITIVE CONTROL, and the premise: a probe on a track the asset
         does not hold links Ret and hears the kick through the routing edge. -->
    <add-track index="-1"/>
    <set-track-name trackPath="2" name="Probe"/>
    <insert-plugin trackPath="2" slotIndex="0"
                   format="tw" uid="tw.native.nassaudigital"
                   name="NassauDigital" vendor="Nassau"
                   path="" nIn="0" nOut="2"/>
    <insert-midi-clip trackPath="2" timePos="0" duration="7680" name="P"/>
    <add-note clip="2,0" tick="0" dur="480" key="60" velocity="127" channel="0"/>
    <add-zone trackPath="2" slotIndex="0" keyLo="60" keyHi="60" rootKey="60" mode="oneshot">
      <layer src="test:none"/>
    </add-zone>
    <set-layer trackPath="2" slotIndex="0" layer="2" src="asset:Ret"/>
    <wait-sampler-generations trackPath="2" slotIndex="0" timeoutMs="15000"/>
    <assert-sampler-layer trackPath="2" slotIndex="0" layer="2" generation="1"
                          renders="1" src="link:1" asset="Ret"/>
    <!-- The master holds the probe alone: the kick is on aux 1 and the return
         is muted. The kick sounds from frame 24000 on, in the bounce. -->
    <render filename="srcl_probe.wav" format="wav" quality="10" durationSec="3.0"/>
    <assert-audio-energy filename="srcl_probe.wav" startFrame="28000" frameCount="88000"
                         channel="0" minRms="0.540" maxRms="0.556"/>
    <assert-audio-energy filename="srcl_probe.wav" startFrame="0" frameCount="23000"
                         channel="0" minRms="0" maxRms="0.001"/>
    <undo/>
    <assert-sampler-program trackPath="2" slotIndex="0" zoneIds="1"
                            scope="layer" id="2" attr="src" value="test:none"/>
    <assert-sampler-layer trackPath="2" slotIndex="0" layer="2" generation="0"/>
    <redo/>
    <wait-sampler-generations trackPath="2" slotIndex="0" timeoutMs="15000"/>
    <assert-sampler-layer trackPath="2" slotIndex="0" layer="2" generation="2"
                          src="link:1" asset="Ret"/>

    <!-- ================================================= B: the KEY edge -->
    <add-track index="-1"/>
    <set-track-name trackPath="3" name="Bass"/>
    <add-sample trackPath="3" filePath="../test_stereo.wav" timePos="0"/>
    <insert-plugin trackPath="3" slotIndex="0"
                   format="clap" uid="tw.test.clap.duck"
                   name="Smaragd Test Duck" vendor="Smaragd"
                   path="twtestclap.clap" nIn="2" nOut="2"/>
    <set-plugin-sidechain trackPath="3" slot="0" source="0"/>
    <create-asset container="3" startOffset="0" duration="144000" assetName="BassA"/>
    <set-layer trackPath="0" slotIndex="0" layer="4" src="asset:BassA" expectReject="true"/>
    <assert-log contains="asset &quot;BassA&quot; contains this sampler's own track &quot;Drums&quot; (&quot;Bass&quot; is keyed from &quot;Drums&quot;)"
                minCount="1" maxCount="1"/>
    <assert-sampler-program trackPath="0" slotIndex="0" zoneIds="1;3"
                            scope="layer" id="4" attr="src" value="test:none"/>
    <assert-sampler-layer trackPath="0" slotIndex="0" layer="4" generation="0" renders="0"/>
    <!-- control: the probe may link it -->
    <add-zone trackPath="2" slotIndex="0" keyLo="61" keyHi="61" rootKey="61" mode="oneshot">
      <layer src="test:none"/>
    </add-zone>
    <set-layer trackPath="2" slotIndex="0" layer="4" src="asset:BassA"/>
    <wait-sampler-generations trackPath="2" slotIndex="0" timeoutMs="15000"/>
    <assert-sampler-layer trackPath="2" slotIndex="0" layer="4" generation="1" asset="BassA"/>

    <!-- ================================== C: a KEY edge from a send lane -->
    <add-send-lane sendName="Bus"/>
    <add-send track="0" dest="Bus" level="0"/>
    <add-track index="-1"/>
    <set-track-name trackPath="4" name="Gate"/>
    <add-sample trackPath="4" filePath="../test_stereo.wav" timePos="0"/>
    <insert-plugin trackPath="4" slotIndex="0"
                   format="clap" uid="tw.test.clap.duck"
                   name="Smaragd Test Duck" vendor="Smaragd"
                   path="twtestclap.clap" nIn="2" nOut="2"/>
    <set-plugin-sidechain trackPath="4" slot="0" source="$send:Bus"/>
    <create-asset container="4" startOffset="0" duration="144000" assetName="GateA"/>
    <set-layer trackPath="0" slotIndex="0" layer="4" src="asset:GateA" expectReject="true"/>
    <assert-log contains="asset &quot;GateA&quot; contains this sampler's own track &quot;Drums&quot; (&quot;Gate&quot; is keyed from &quot;Bus&quot;, &quot;Drums&quot; sends to &quot;Bus&quot;)"
                minCount="1" maxCount="1"/>
    <assert-sampler-program trackPath="0" slotIndex="0" zoneIds="1;3"
                            scope="layer" id="4" attr="src" value="test:none"/>
    <assert-sampler-layer trackPath="0" slotIndex="0" layer="4" generation="0" renders="0"/>
    <!-- control: the probe may link it -->
    <add-zone trackPath="2" slotIndex="0" keyLo="62" keyHi="62" rootKey="62" mode="oneshot">
      <layer src="test:none"/>
    </add-zone>
    <set-layer trackPath="2" slotIndex="0" layer="6" src="asset:GateA"/>
    <wait-sampler-generations trackPath="2" slotIndex="0" timeoutMs="15000"/>
    <assert-sampler-layer trackPath="2" slotIndex="0" layer="6" generation="1" asset="GateA"/>

    <!-- ============ E: a DISABLED tap is an edge too (set-send may enable it
         later, and set-send walks no cycle) -->
    <add-send-lane sendName="Bus2"/>
    <add-send track="0" dest="Bus2" level="0" enabled="false"/>
    <add-track index="-1"/>
    <set-track-name trackPath="5" name="Gate2"/>
    <add-sample trackPath="5" filePath="../test_stereo.wav" timePos="0"/>
    <insert-plugin trackPath="5" slotIndex="0"
                   format="clap" uid="tw.test.clap.duck"
                   name="Smaragd Test Duck" vendor="Smaragd"
                   path="twtestclap.clap" nIn="2" nOut="2"/>
    <set-plugin-sidechain trackPath="5" slot="0" source="$send:Bus2"/>
    <create-asset container="5" startOffset="0" duration="144000" assetName="Gate2A"/>
    <add-zone trackPath="0" slotIndex="0" keyLo="61" keyHi="61" rootKey="61" mode="oneshot">
      <layer src="test:none"/>
    </add-zone>
    <set-layer trackPath="0" slotIndex="0" layer="6" src="asset:Gate2A" expectReject="true"/>
    <assert-log contains="asset &quot;Gate2A&quot; contains this sampler's own track &quot;Drums&quot; (&quot;Gate2&quot; is keyed from &quot;Bus2&quot;, &quot;Drums&quot; sends to &quot;Bus2&quot;)"
                minCount="1" maxCount="1"/>
    <assert-sampler-layer trackPath="0" slotIndex="0" layer="6" generation="0" renders="0"/>

    <!-- ===== D: a send FROM inside an asset is no edge INTO it. "Out" sends to
         Bus as Drums does; the bounce of Out is Out's own output, which a send
         does not feed back, so Drums may link it. -->
    <add-track index="-1"/>
    <set-track-name trackPath="6" name="Out"/>
    <add-sample trackPath="6" filePath="../test_stereo.wav" timePos="0"/>
    <add-send track="6" dest="Bus" level="0"/>
    <create-asset container="6" startOffset="0" duration="144000" assetName="OutA"/>
    <set-layer trackPath="0" slotIndex="0" layer="6" src="asset:OutA"/>
    <wait-sampler-generations trackPath="0" slotIndex="0" timeoutMs="15000"/>
    <assert-sampler-layer trackPath="0" slotIndex="0" layer="6" generation="1"
                          renders="1" asset="OutA"/>
    <assert-log contains="contains this sampler's own track" minCount="0" maxCount="0"/>

    <!-- ===================== the release: with the return unrouted, Drums
         may link Ret, and it bounces ONCE: nothing feeds the bounce back. -->
    <clear-return-source trackPath="1"/>
    <assert-return-track trackPath="1" isReturn="0"/>
    <set-layer trackPath="0" slotIndex="0" layer="4" src="asset:Ret"/>
    <wait-sampler-generations trackPath="0" slotIndex="0" timeoutMs="15000"/>
    <assert-sampler-layer trackPath="0" slotIndex="0" layer="4" generation="1"
                          renders="1" asset="Ret"/>
    <wait-ms ms="1500"/>
    <assert-sampler-layer trackPath="0" slotIndex="0" layer="4" generation="1"
                          rendering="0" renders="1"/>
  </actions>

</SActionScript>
