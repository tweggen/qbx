<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proposal 09 section 3: SELECTION IS PER EDITOR ROOT.

  THE HAZARD THIS CLOSES, stated plainly: one global selection was fine while
  one arranger could be on screen. With two tabs open, selecting a clip in the
  Drums tab and then driving a delete from the MASTER tab deleted the Drums
  clip = the menus, the transport and the delete key all read one list that
  belonged to whichever tab had touched it last. Until the tab shell landed
  nothing could open a second tab; the double-click drill-in made it a gesture
  a user can perform by accident.

  The design is section 3 exactly: the selection is kept per ROOT, and the
  ACTIVE tab publishes itself as the app-wide selection context. Per ROOT
  rather than per view because the shell dedups by root identity (one root, at
  most one view) and because a selection must survive its tab being closed and
  reopened.

  Every assertion here is a PAIR, for the same reason as the other arrangement
  cases: index 0 exists in both roots, so a selection written into the wrong
  list is not an error, it is a silent one.
-->
<SActionScript version="1" name="tabs_selection_scoped">

  <setup project="new"/>

  <actions>
    <add-track index="-1"/>
    <add-sample trackIndex="0" filePath="../test_sawtooth.wav" timePos="0"/>
    <add-sample trackIndex="0" filePath="../test_sawtooth.wav" timePos="192000"/>

    <create-arrangement name="Drums"/>
    <add-track arrangement="Drums" index="-1"/>
    <add-sample trackPath="Drums:0" filePath="../test_sawtooth.wav" timePos="0"/>
    <add-sample trackPath="Drums:0" filePath="../test_sawtooth.wav" timePos="192000"/>

    <open-arrangement-tab name="Drums"/>
    <assert-tab-set names="Arrangement,Drums" active="Drums"/>

    <!-- Select a clip IN DRUMS while the Drums tab is active. -->
    <set-selection paths="Drums:0,0"/>
    <assert-selection paths="Drums:0,0"/>

    <!-- Switch to the master. Its selection is its OWN = empty, not Drums'. -->
    <activate-tab name="Arrangement"/>
    <assert-selection paths=""/>

    <!-- Select something else in the master. -->
    <set-selection paths="0,1"/>
    <assert-selection paths="0,1"/>

    <!-- Back to Drums: its selection is still what it was, untouched by
         anything the master tab did. THIS is the pair that fails on one
         global list. -->
    <activate-tab name="Drums"/>
    <assert-selection paths="Drums:0,0"/>

    <!-- And back again: the master's is still its own. -->
    <activate-tab name="Arrangement"/>
    <assert-selection paths="0,1"/>

    <!-- A selection survives its TAB being closed and reopened: it is keyed on
         the root, not on the view that happened to be showing it. -->
    <close-arrangement-tab name="Drums"/>
    <open-arrangement-tab name="Drums"/>
    <assert-selection paths="Drums:0,0"/>
  </actions>

</SActionScript>
