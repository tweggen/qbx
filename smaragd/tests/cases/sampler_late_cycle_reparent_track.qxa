<?xml version="1.0" encoding="UTF-8"?>
<SActionScript version="1" name="sampler_late_cycle_reparent_track">

  <!-- QBX-267 (proposal 56 §11 Q3, objects/sampler CONTRACT inv. 22):
       REPARENT-TRACK REFUSES A MOVE THAT WOULD CLOSE A CYCLE.

       The ticket's own example: the sampler on "Synth" links "FoldAsset", an
       asset over the folder "Folder" (no cycle: Folder does not hold Synth).
       Moving Synth INTO Folder would make the asset hold the very track
       whose sampler bounces it: Folder -> Synth -(sampler)-> FoldAsset ->
       Folder. isSelfOrDescendant sees only the tree, so on main the move is
       accepted, and the case dies at teardown on the refcount cycle.

       The same guard refuses a PLAIN reference cycle reparent-track never
       refused before: "Holder" holds a placement of FoldAsset, so Holder in
       Folder is Folder -> Holder -> FoldAsset -> Folder (a different line).

       Positive controls: "Plain" (holds nothing) moved into Folder, with undo
       and redo; and once Synth lets go of FoldAsset, Synth moves in, and the
       LINK-time check then refuses re-linking it from inside: one check. -->

  <setup project="new"/>

  <actions>
    <add-track index="-1"/>
    <set-track-name trackPath="0" name="Synth"/>
    <insert-plugin trackPath="0" slotIndex="0"
                   format="tw" uid="tw.native.nassaudigital"
                   name="NassauDigital" vendor="Nassau"
                   path="" nIn="0" nOut="2"/>
    <add-zone trackPath="0" slotIndex="0" keyLo="0" keyHi="127" rootKey="60" mode="oneshot">
      <layer src="test:none"/>
    </add-zone>

    <!-- 1 = Folder { 1,0 = Inner }, 2 = Holder, 3 = Plain -->
    <add-track index="-1"/>
    <set-track-name trackPath="1" name="Folder"/>
    <add-track index="-1"/>
    <set-track-name trackPath="2" name="Inner"/>
    <reparent-track source="2" destParent="1" destIndex="-1"/>
    <add-sample trackPath="1,0" filePath="../test_stereo.wav" timePos="0"/>
    <add-track index="-1"/>
    <set-track-name trackPath="2" name="Holder"/>
    <add-track index="-1"/>
    <set-track-name trackPath="3" name="Plain"/>

    <create-asset container="1" startOffset="0" duration="48000" assetName="FoldAsset"/>
    <place-asset assetName="FoldAsset" trackPath="2" timePos="0"/>

    <set-layer trackPath="0" slotIndex="0" layer="2" src="asset:FoldAsset"/>
    <wait-sampler-generations trackPath="0" slotIndex="0" timeoutMs="15000"/>
    <assert-sampler-layer trackPath="0" slotIndex="0" layer="2" generation="1"
                          asset="FoldAsset"/>

    <!-- ======================================== THE REFUSAL (sampler hop) -->
    <reparent-track source="0" destParent="1" destIndex="-1" expectReject="true"/>
    <assert-log contains="reparent-track: refused, moving &quot;Synth&quot; into &quot;Folder&quot; would close a sampler asset-link cycle (the sampler on &quot;Synth&quot; links &quot;FoldAsset&quot;)"
                minCount="1" maxCount="1"/>
    <assert-track-count count="4"/>
    <assert-track-name trackPath="0" name="Synth"/>

    <!-- ================================== the PLAIN cycle, refused as well -->
    <reparent-track source="2" destParent="1" destIndex="-1" expectReject="true"/>
    <assert-log contains="reparent-track: refused, moving &quot;Holder&quot; into &quot;Folder&quot; would close a reference cycle"
                minCount="1" maxCount="1"/>
    <assert-track-count count="4"/>
    <assert-track-name trackPath="2" name="Holder"/>

    <!-- ============== POSITIVE CONTROL: Plain into Folder closes nothing -->
    <reparent-track source="3" destParent="1" destIndex="-1"/>
    <assert-log contains="would close" minCount="0" maxCount="0"/>
    <assert-track-count count="3"/>
    <assert-track-name trackPath="1,1" name="Plain"/>
    <undo/>
    <assert-track-count count="4"/>
    <assert-track-name trackPath="3" name="Plain"/>
    <redo/>
    <assert-track-name trackPath="1,1" name="Plain"/>
    <undo/>

    <!-- ====== THE HOP'S POSITIVE CONTROL: Synth lets go, the move is accepted -->
    <set-layer trackPath="0" slotIndex="0" layer="2" src="test:none"/>
    <reparent-track source="0" destParent="1" destIndex="-1"/>
    <assert-log contains="would close" minCount="0" maxCount="0"/>
    <assert-track-count count="3"/>
    <assert-track-name trackPath="0,1" name="Synth"/>
    <undo/>
    <assert-track-name trackPath="0" name="Synth"/>
    <redo/>
    <assert-track-name trackPath="0,1" name="Synth"/>
    <!-- From inside Folder, linking FoldAsset is the link-time refusal. -->
    <set-layer trackPath="0,1" slotIndex="0" layer="2" src="asset:FoldAsset" expectReject="true"/>
    <assert-log contains="asset &quot;FoldAsset&quot; contains this sampler's own track" minCount="1" maxCount="1"/>
  </actions>

</SActionScript>
