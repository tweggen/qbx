<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proposal 45 M2, AC2.2 and AC2.4: the master lane is IN THE SIGNAL PATH, and
  an edit to it made after pages are already frozen is heard.

  THE CASE RENDERS BEFORE THE EDIT ON PURPOSE, and that is AC2.4's whole
  point. A case that renders only afterwards finds every page cold and passes
  whether or not invalidation works; it cannot see the defect it exists to
  catch. Measured with the D11 delegation reverted: a master edit bumps only
  the lane's OWN caches, because SObject::invalidateRenderPath() walks down
  from the project root through childLinks() and a system lane is deliberately
  not among them (D2). The mixer's rewire keeps serving the page it already
  had, and the render is byte-unchanged.

  THE CLOSED FORM. ../test_autosaw.wav is a 480 Hz sawtooth whose period is
  exactly 100 frames, so a whole-second window has no partial period and its
  RMS is A/sqrt(3) exactly. Measured base: 0.230956 over [48000, 96000) on
  channel 0, i.e. A = 0.40003. At 2.5x that is 0.577390 and the peak reaches
  0.99999 - inside full scale, which is why the gain the proposal names is
  usable as written rather than needing headroom.

  A NOTE ON WHY path= IS SPELLED OUT below: without it the scan finds no
  module, insert-plugin quietly builds the TRANSPARENT PLACEHOLDER, and every
  level assertion here reads the base RMS. That failure looks exactly like a
  broken signal path and is not one.
-->
<SActionScript version="1" name="master_insert_heard">

  <setup project="new"/>

  <actions>
    <add-track index="-1"/>
    <add-sample trackPath="0" filePath="../test_autosaw.wav" timePos="0"/>

    <!-- (1) The base, with an EMPTY master chain at 0 dB in the path. -->
    <render filename="mih_base.wav" format="wav" quality="10" durationSec="4.0"/>
    <assert-audio-energy filename="mih_base.wav" channel="0"
                         startFrame="48000" frameCount="48000"
                         minRms="0.2300" maxRms="0.2320"/>

    <!-- (2) A gain plugin ON THE MASTER, inserted through the ordinary verb
             with no change of its own: the return on "a system lane IS an
             STrack". -->
    <insert-plugin trackPath="$master" slotIndex="0"
                   format="clap" uid="tw.test.clap.gain"
                   name="Smaragd Test Gain" vendor="Smaragd"
                   path="twtestclap.clap" nIn="2" nOut="2"/>
    <set-plugin-param trackPath="$master" slotIndex="0" paramId="0" value="2.5"/>
    <assert-system-lane trackPath="$master" role="master" plugins="1"/>

    <!-- (3) AC2.2 + AC2.4: heard, in the SAME process, on a position that was
             already frozen. 0.230956 x 2.5 = 0.577390. -->
    <render filename="mih_gain.wav" format="wav" quality="10" durationSec="4.0"/>
    <assert-audio-energy filename="mih_gain.wav" channel="0"
                         startFrame="48000" frameCount="48000"
                         minRms="0.5745" maxRms="0.5803"/>

    <!-- ...and it is not merely LOUDER: it must differ from the base render
             as a file, which a level band alone cannot say. -->
    <assert-file-identical actual="mih_gain.wav" expected="mih_base.wav"
                           expectReject="true"/>

    <!-- (4) And back. This says the difference was the insert and not drift,
             and it exercises invalidation in BOTH directions - the shape
             mc_golden_stereo's own mute control uses. -->
    <undo count="2"/>
    <assert-system-lane trackPath="$master" plugins="0"/>
    <render filename="mih_undone.wav" format="wav" quality="10" durationSec="4.0"/>
    <assert-file-identical actual="mih_undone.wav" expected="mih_base.wav"/>
  </actions>

</SActionScript>
