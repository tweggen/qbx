<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proposal 34: the meter tap is POST-FADER.

  This matters because it decides what the meter MEANS. The tap is a track's root
  component (its twRewire), which sits downstream of the fader, so the reading is
  the track's actual contribution to the mix rather than the raw clip level. Pull
  the fader down and the meter must follow. (Since proposal 37 P3a the fader is
  twGainStage, the rewire's own producer, applied AFTER the inserts; before that
  it was a scalar inside twTrackMix, further upstream still. The reading was
  post-fader either way, which is what this case is about.)

  Two tracks carrying the SAME sample at different gains, rather than one track
  whose gain is changed twice. That WAS a requirement: assert-meter drives the
  legacy pull, where a gain change made after the position had been frozen once
  was not observed. Proposal 37 P3a retired that caveat: the epoch the rewire's
  cached input page is gated on is now the one set-track-volume bumps, and
  meter_gain_after_probe.qxa is the case that proves it. This shape is kept
  because it is a good one - two tracks, one difference, no ordering to reason
  about.

  Fixture: ../test_sawtooth.wav, whose 4th second has RMS ~0.405
  (testkit/CONTRACT.md inv. 3). Position 168000 is inside that second.
-->
<SActionScript version="1" name="meter_postfader">

  <setup project="new"/>

  <actions>
    <add-track index="-1"/>
    <add-track index="-1"/>

    <!-- Gains FIRST, so each track's page is frozen at its final gain. -->
    <set-track-volume trackIndex="1" volume="-6.0206"/>

    <add-sample trackIndex="0" filePath="../test_sawtooth.wav" timePos="0"/>
    <add-sample trackIndex="1" filePath="../test_sawtooth.wav" timePos="0"/>

    <!-- Track 0 at unity reads the source level... -->
    <assert-meter trackIndex="0" position="168000" minRms="0.300" maxRms="0.510"/>
    <!-- ...and track 1 at -6.02 dB reads half of it. Same sample, same position,
         same probe: the only difference is the fader, so this isolates it. -->
    <assert-meter trackIndex="1" position="168000" minRms="0.150" maxRms="0.255"/>
  </actions>

  <assertions>
    <assert-track-count equals="2"/>
  </assertions>

</SActionScript>
