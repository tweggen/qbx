<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proposal 09 M8c: an arrangement opens in a TAB, and a gesture made in that tab
  edits that arrangement.

  THIS IS THE CASE THE MILESTONE EXISTS FOR. M8b made every path carry its root;
  this drives the ARRANGER itself, through the real mouse handlers
  (drag-clip-edge), with an arrangement tab active, and asserts the edit landed
  in the arrangement and NOT in the master.

  IT WAS PARKED, FAILING, FOR A WHILE, AND THE REASON IS WORTH KEEPING: the
  product code was right the whole time and THE GATE WAS LYING. Two theories
  were tested and refuted first = that a tab page added mid-script is never laid
  out (measured: both views compute identical coordinates, sx=0 ex=120 x0=119
  x1=60, on identical 300x150 views), and that its layout needed activating.
  The actual fault was in assert-clip-window: it kept its path as TEXT and
  converted it with stringToPath(), which splits on commas =
  stringToPath("Drums:0,0") yields (0,0) because "Drums:0".toInt() is 0. So the
  ASSERTION read the master while the EDIT correctly went to Drums.

  A second bug fell out of fixing that: parseInto() is what SETS the root from a
  qualified text path, so resolving the root BEFORE calling it reads an empty
  root and addresses the master anyway. Three sites had that ordering.

  The lesson is the one this repo keeps relearning: a gate that disagrees with
  the code is not automatically evidence about the code.

  The two roots are given confusable shapes on purpose: a lane at index 0 in
  each, one clip each, differing only in name. The drag is PIXEL-QUANTISED, so
  its exact result is not assertable; what IS exact is the pairing = the clip on
  the OTHER side untouched at 192000, and the clip on THIS side no longer
  192000, expressed as an assertion marked expectReject.
-->
<SActionScript version="1" name="tabs_edit_in_arrangement">

  <setup project="new"/>

  <actions>
    <add-track index="-1"/>
    <set-track-name trackPath="0" name="MasterLane"/>
    <add-sample trackIndex="0" filePath="../test_sawtooth.wav" timePos="0"/>

    <create-arrangement name="Drums"/>
    <add-track arrangement="Drums" index="-1"/>
    <set-track-name trackPath="Drums:0" name="DrumLane"/>
    <add-sample trackPath="Drums:0" filePath="../test_sawtooth.wav" timePos="0"/>

    <!-- One tab so far. -->
    <assert-tab-set names="Arrangement" active="Arrangement"/>

    <!-- Open the arrangement in its own tab, and make it the active one. -->
    <open-arrangement-tab name="Drums"/>
    <assert-tab-set names="Arrangement,Drums" active="Drums"/>

    <!-- Opening it TWICE focuses the one tab rather than spawning a second
         editor that would fight the first over the same model. -->
    <open-arrangement-tab name="Drums"/>
    <assert-tab-set names="Arrangement,Drums" active="Drums"/>

    <!-- A REAL ARRANGER GESTURE, with the Drums tab active: drag the clip's
         right edge. It must resize the clip in DRUMS. -->
    <assert-clip-window clip="Drums:0,0" duration="192000"/>
    <assert-clip-window clip="0,0" duration="192000"/>
    <drag-clip-edge track="0" clip="0" edge="end" toTime="96000"/>
    <assert-clip-window clip="Drums:0,0" duration="192000" expectReject="true"/>
    <assert-clip-window clip="0,0" duration="192000"/>

    <!-- ...and its UNDO lands in Drums too, not in the master. -->
    <undo/>
    <assert-clip-window clip="Drums:0,0" duration="192000"/>
    <assert-clip-window clip="0,0" duration="192000"/>

    <!-- Back on the master tab, the same gesture edits the MASTER. -->
    <activate-tab name="Arrangement"/>
    <assert-tab-set names="Arrangement,Drums" active="Arrangement"/>
    <drag-clip-edge track="0" clip="0" edge="end" toTime="96000"/>
    <assert-clip-window clip="0,0" duration="192000" expectReject="true"/>
    <assert-clip-window clip="Drums:0,0" duration="192000"/>
    <undo/>
    <assert-clip-window clip="0,0" duration="192000"/>

    <!-- Closing a tab destroys the VIEW and nothing else. -->
    <close-arrangement-tab name="Drums"/>
    <assert-tab-set names="Arrangement" active="Arrangement"/>
    <assert-arrangements names="Drums" trackCounts="1"/>
    <assert-track-name trackPath="Drums:0" name="DrumLane"/>
  </actions>

</SActionScript>
