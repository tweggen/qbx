<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proposal 55 M4, AC4.6 (T7): ROUTING LENGTHENS DEPENDENCY PATHS, AND THE
  PLANNER'S DEPTH GUARD MUST NOT CUT THEM.

  CaptureRevalidator::expandNode_ refuses to expand a dependency deeper than
  64 levels, and a refused dependency is a page NOTHING PLANNED - silently,
  until this milestone counted it (GraphStats::depthDrops). Every insert on a
  path is a planner level of its own, and a key adds a whole second path
  through the key lane, so the deepest realistic shape is the one T7 names:
  a key from a return of a nested instrument, inside folders, into a keyed
  track that is itself nested, with full chains on every level.

    F1 > F2 > F3 > "Kick"   test_clipsaw.wav from frame 24000 through two
                            unity gains and tw.test.clap.split (MainLevel 0);
                            each folder carries a unity gain too
    F3 > "Kick Aux 1"       the return of Kick's aux, MUTED, two unity gains
    G1 > G2 > "Bass"        test_stereo.wav through a unity gain,
                            tw.test.clap.duck keyed from the return, and two
                            more unity gains; each folder a unity gain
    $send:Verb              fed post-fader from Bass, two unity gains

  Every gain is tw.test.clap.gain at 1.0, an exact x 1.0f, so the duck's
  closed form still holds through all of them: Bass at 0.25 x dry inside the
  key (the case is not merely deep, it is deep AND right). The render is
  then asserted to have planned every dependency (depthDrops 0) at a depth
  of at least 24, the witness that the case is as deep as it claims.

  MEASURED (2026-11-01): this case reaches depth 27 with no drop, the same
  in three serial runs and under ctest -j4. It is the deepest case in the
  suite; the deepest case before M4 is group_nested_track at 16. The guard
  is 64, so the headroom is 37 levels.

  Watched failing: with kMaxExpandDepth lowered below the measured depth, the
  render-policy assertion reports the dropped dependencies.
-->
<SActionScript version="1" name="sidechain_depth">

  <setup project="new"/>

  <actions>
    <!-- F1 > F2 > F3 > Kick -->
    <add-track index="-1"/>
    <set-track-name trackPath="0" name="F1"/>
    <add-track index="-1"/>
    <set-track-name trackPath="1" name="F2"/>
    <add-track index="-1"/>
    <set-track-name trackPath="2" name="F3"/>
    <add-track index="-1"/>
    <set-track-name trackPath="3" name="Kick"/>
    <reparent-track source="3" destParent="2" destIndex="-1"/>
    <reparent-track source="2" destParent="1" destIndex="-1"/>
    <reparent-track source="1" destParent="0" destIndex="-1"/>
    <assert-track-count count="1"/>

    <add-sample trackPath="0,0,0,0" filePath="../test_clipsaw.wav" timePos="24000"/>
    <insert-plugin trackPath="0,0,0,0" slotIndex="0" format="clap" uid="tw.test.clap.gain"
                   name="Smaragd Test Gain" vendor="Smaragd" path="twtestclap.clap" nIn="2" nOut="2"/>
    <insert-plugin trackPath="0,0,0,0" slotIndex="1" format="clap" uid="tw.test.clap.gain"
                   name="Smaragd Test Gain" vendor="Smaragd" path="twtestclap.clap" nIn="2" nOut="2"/>
    <insert-plugin trackPath="0,0,0,0" slotIndex="2" format="clap" uid="tw.test.clap.split"
                   name="Smaragd Test Split" vendor="Smaragd" path="twtestclap.clap" nIn="2" nOut="2"/>
    <set-plugin-param trackPath="0,0,0,0" slotIndex="2" paramId="0" value="0"/>
    <insert-plugin trackPath="0" slotIndex="0" format="clap" uid="tw.test.clap.gain"
                   name="Smaragd Test Gain" vendor="Smaragd" path="twtestclap.clap" nIn="2" nOut="2"/>
    <insert-plugin trackPath="0,0" slotIndex="0" format="clap" uid="tw.test.clap.gain"
                   name="Smaragd Test Gain" vendor="Smaragd" path="twtestclap.clap" nIn="2" nOut="2"/>
    <insert-plugin trackPath="0,0,0" slotIndex="0" format="clap" uid="tw.test.clap.gain"
                   name="Smaragd Test Gain" vendor="Smaragd" path="twtestclap.clap" nIn="2" nOut="2"/>

    <!-- The return lands right after Kick, inside F3. -->
    <add-return-track trackPath="0,0,0,0" slot="2" bus="1"/>
    <assert-return-track trackPath="0,0,0,1" source="0,0,0,0" slot="2" bus="1" routed="1"/>
    <set-track-mute trackPath="0,0,0,1" muted="1"/>
    <insert-plugin trackPath="0,0,0,1" slotIndex="0" format="clap" uid="tw.test.clap.gain"
                   name="Smaragd Test Gain" vendor="Smaragd" path="twtestclap.clap" nIn="2" nOut="2"/>
    <insert-plugin trackPath="0,0,0,1" slotIndex="1" format="clap" uid="tw.test.clap.gain"
                   name="Smaragd Test Gain" vendor="Smaragd" path="twtestclap.clap" nIn="2" nOut="2"/>

    <!-- G1 > G2 > Bass -->
    <add-track index="-1"/>
    <set-track-name trackPath="1" name="G1"/>
    <add-track index="-1"/>
    <set-track-name trackPath="2" name="G2"/>
    <add-track index="-1"/>
    <set-track-name trackPath="3" name="Bass"/>
    <reparent-track source="3" destParent="2" destIndex="-1"/>
    <reparent-track source="2" destParent="1" destIndex="-1"/>
    <assert-track-count count="2"/>
    <add-sample trackPath="1,0,0" filePath="../test_stereo.wav" timePos="0"/>
    <insert-plugin trackPath="1,0,0" slotIndex="0" format="clap" uid="tw.test.clap.gain"
                   name="Smaragd Test Gain" vendor="Smaragd" path="twtestclap.clap" nIn="2" nOut="2"/>
    <insert-plugin trackPath="1,0,0" slotIndex="1" format="clap" uid="tw.test.clap.duck"
                   name="Smaragd Test Duck" vendor="Smaragd" path="twtestclap.clap" nIn="2" nOut="2"/>
    <insert-plugin trackPath="1,0,0" slotIndex="2" format="clap" uid="tw.test.clap.gain"
                   name="Smaragd Test Gain" vendor="Smaragd" path="twtestclap.clap" nIn="2" nOut="2"/>
    <insert-plugin trackPath="1,0,0" slotIndex="3" format="clap" uid="tw.test.clap.gain"
                   name="Smaragd Test Gain" vendor="Smaragd" path="twtestclap.clap" nIn="2" nOut="2"/>
    <insert-plugin trackPath="1" slotIndex="0" format="clap" uid="tw.test.clap.gain"
                   name="Smaragd Test Gain" vendor="Smaragd" path="twtestclap.clap" nIn="2" nOut="2"/>
    <insert-plugin trackPath="1,0" slotIndex="0" format="clap" uid="tw.test.clap.gain"
                   name="Smaragd Test Gain" vendor="Smaragd" path="twtestclap.clap" nIn="2" nOut="2"/>

    <set-plugin-sidechain trackPath="1,0,0" slot="1" source="0,0,0,1"/>
    <assert-plugin-sidechain trackPath="1,0,0" slot="1" keyed="1" source="0,0,0,1" wired="1"
                             mapping="mapping=copy"/>

    <!-- A send lane fed from Bass, with a chain of its own. Its level is
         -1000 dB, so it adds nothing to the file but every level to the
         graph. -->
    <add-send-lane sendName="Verb"/>
    <add-send track="1,0,0" dest="Verb" level="-1000" pre="false" enabled="true"/>
    <insert-plugin trackPath="$send:Verb" slotIndex="0" format="clap" uid="tw.test.clap.gain"
                   name="Smaragd Test Gain" vendor="Smaragd" path="twtestclap.clap" nIn="2" nOut="2"/>
    <insert-plugin trackPath="$send:Verb" slotIndex="1" format="clap" uid="tw.test.clap.gain"
                   name="Smaragd Test Gain" vendor="Smaragd" path="twtestclap.clap" nIn="2" nOut="2"/>

    <render filename="scdepth.wav" format="wav" quality="10" durationSec="3.0"/>
    <!-- Deep AND right: the duck's closed form through every unity gain. -->
    <assert-audio-energy filename="scdepth.wav" startFrame="28000" frameCount="88000"
                         channel="0" minRms="0.12375" maxRms="0.12625"/>
    <assert-audio-energy filename="scdepth.wav" startFrame="28000" frameCount="88000"
                         channel="1" minRms="0.061875" maxRms="0.063125"/>
    <assert-audio-energy filename="scdepth.wav" startFrame="124000" frameCount="20000"
                         channel="0" minRms="0.495" maxRms="0.505"/>

    <!-- T7: every dependency planned, at the depth this case reaches. -->
    <assert-render-policy maxDepthDrops="0" minPlanDepth="24"/>
  </actions>
</SActionScript>
