<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proposal 55 M2, AC2.1 = NassauDigital GATES.md X2.1: A PLUGIN'S SECOND OUTPUT
  BUS, ROUTED TO A RETURN TRACK, RENDERS EQUAL TO THE BUS SIGNAL, BYTE FOR BYTE.

  tw.test.clap.split is an effect with a stereo main out and a stereo AUX out
  (its bus 1): aux = in, a COPY with no arithmetic, and main = in * MainLevel.
  With MainLevel 0 the source track's own output is exactly 0.0, so the file
  holds the RETURN alone: the aux bus, read through the return track's
  twPluginAuxTap (55 D2), its empty chain, its unity fader and its rewire.

  THE FIXTURE IS test_stereo.wav, whose two channels differ, and not the
  test_sawtooth.wav the proposal suggests: every saw fixture has identical
  channels, and over one of them a tap reading its bus one channel to the
  right rendered byte-identical to the reference (measured, the first draft
  of this case).

  THE REFERENCE is the same clip on a plain track with no plugin, rendered in
  the same case after the return and the plugin are taken away. A plain track
  is trackmix, chain, fader, rewire; the return is tap, chain, fader, rewire
  over the aux, which is the source's trackmix output copied. So the two files
  agree to the byte or the route is wrong somewhere - D4's A == C row is a
  COPY precisely so that this comparison can be made with no tolerance.

  THE SECOND SECTION is the T8 negative control's mirror: assert-return-track
  reads the LIVE plugs (routed=1), not only the attribute, and the source
  slot's mask is exactly bit 1 (2).

  Watched failing (AC2.1): with the tap reading its bus at side-page offset +1
  channel, and with the return's twTrackMix left connected instead of the tap.
-->
<SActionScript version="1" name="return_track_split_cmp">

  <setup project="new"/>

  <actions>
    <add-track index="-1"/>
    <add-sample trackPath="0" filePath="../test_stereo.wav" timePos="0"/>
    <insert-plugin trackPath="0" slotIndex="0"
                   format="clap" uid="tw.test.clap.split"
                   name="Smaragd Test Split" vendor="Smaragd"
                   path="twtestclap.clap" nIn="2" nOut="2"/>
    <!-- MainLevel 0: the source's own output is exactly 0.0. -->
    <set-plugin-param trackPath="0" slotIndex="0" paramId="0" value="0"/>

    <add-return-track trackPath="0" slot="0" bus="1"/>
    <assert-track-count count="2"/>
    <assert-return-track trackPath="1" isReturn="1" source="0" slot="0" bus="1"
                         routed="1" mapping="mapping=copy" mask="2"/>
    <assert-track-name trackPath="1" prefix="" suffix="Aux 1"/>

    <render filename="rt_split_return.wav" format="wav" quality="10" durationSec="3.0"/>
    <!-- Not silent: a wiped route would compare equal to a silent reference. -->
    <!-- test_stereo.wav's channels DIFFER (L at RMS 0.5, R at 0.25), so a
         tap that reads the wrong channel of the side page cannot pass for
         the right one: every saw fixture in tests/ has identical channels,
         and against one the offset-by-one sabotage below went UNBITTEN. -->
    <assert-audio-energy filename="rt_split_return.wav" startFrame="24000"
                         frameCount="96000" channel="0" minRms="0.49" maxRms="0.51"/>
    <assert-audio-energy filename="rt_split_return.wav" startFrame="24000"
                         frameCount="96000" channel="1" minRms="0.24" maxRms="0.26"/>

    <!-- THE REFERENCE: the same clip on a plain track with no plugin. -->
    <remove-track trackPath="1"/>
    <remove-plugin trackPath="0" slotIndex="0"/>
    <assert-track-count count="1"/>
    <render filename="rt_split_plain.wav" format="wav" quality="10" durationSec="3.0"/>

    <assert-file-identical actual="rt_split_return.wav" expected="rt_split_plain.wav"/>
  </actions>
</SActionScript>
