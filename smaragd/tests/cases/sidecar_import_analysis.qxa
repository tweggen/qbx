<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proposal 27 M1: importing a wave enqueues background sidecar analysis
  (onsets, loudness). This case points the sidecar store at the hermetic
  test-output dir, imports the 4 s sawtooth fixture, waits for the analysis
  lane to drain, and asserts the onset and loudness sidecars appear with the
  expected record counts.

  Fixture: ../test_sawtooth.wav (4 s ramped sawtooth). loudness recordCount is
  deterministic: ceil(sourceFrames / hop), hop = sourceRate/100 (10 ms).
-->
<SActionScript version="1" name="sidecar_import_analysis">

  <setup project="new"/>

  <actions>
    <!-- Hermetic store: sidecars land under this case's test-output dir. -->
    <sidecar-root/>

    <add-track index="-1"/>
    <add-sample trackIndex="0" filePath="../test_sawtooth.wav" timePos="0"/>

    <!-- Drain the analysis lane before inspecting the store. -->
    <wait-analysis timeoutMs="30000"/>

    <!-- onsets: a spectral-flux transient count for the ramped sawtooth.
         Observed 81 onsets; pinned as a band of +/-2 (79..83). -->
    <assert-sidecar aspect="onsets" expectExists="true"
                    minRecords="45" maxRecords="55"/>
    <!-- Onsets v2 band (was 79..83 under v1): normalized flux + energy gate
         + 0.1 floor yields 49 on this fixture. The fixture is a continuous
         crescendo - a pathological onset input; the band pins detector
         DETERMINISM, not musical truth (warp-marker semantics are M6). -->

    <!-- loudness: RMS envelope, exact recordCount = ceil(sourceFrames/hop)
         = ceil(192000 / (48000/100)) = ceil(192000/480) = 400. -->
    <assert-sidecar aspect="loudness" expectExists="true"
                    minRecords="400" maxRecords="400"/>

    <!-- f0 (proposal 28 W3): per-hop fundamental, same 10 ms hop as
         loudness, so the record count is the same exact 400. -->
    <assert-sidecar aspect="f0" expectExists="true"
                    minRecords="400" maxRecords="400"/>
  </actions>

  <assertions>
    <assert-track-count equals="1"/>
  </assertions>

</SActionScript>
