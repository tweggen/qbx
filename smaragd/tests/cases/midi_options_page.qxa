<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proposal 37 P7b, AC6. The Options -> MIDI page (design 6.3).

  The page mirrors the Audio one - same build/load/apply triple, same rule that
  the DEVICE LIST comes from the backend rather than from a hard-coded table -
  so the assertion is that it lists exactly what the active MIDI backend
  reports, and nothing else. Under a headless test run that backend is `capture`,
  which reports exactly one synthetic endpoint on each side: an Options page
  showing the machine's real MIDI ports while the capture backend was active
  would be a lie, and this is where that lie would show.

  Built OFF SCREEN and never shown (the house pattern): a qxa run on Windows
  uses the real platform plugin, so a shown dialog would appear on the
  developer's screen.

  This case OWNS the midi/outOffsetMs setting - `set-option` writes the real
  per-user smaragd.ini - and puts it back at the end. It is RUN_SERIAL for the
  same reason: the MIDI-out pump reads that value at every transport start, so
  a concurrent playback case would inherit it.
-->
<SActionScript version="1" name="midi_options_page">

  <setup project="new"/>

  <actions>
    <!-- The OUTPUT list is exactly the backend's own ports: one, no more.
         The INPUT list is TWO since proposal 21 L2, and the extra one is not a
         device: the computer keyboard is a real in-process MidiInput port
         (design D9), enumerated beside the hardware so a user can select it
         and a track can name it. It is listed FIRST because it is the port
         that always exists, whatever SMARAGD_MIDI_BACKEND chose - and it is
         reached by createMidiInput("keyboard"), which that variable cannot
         override. -->
    <assert-midi-options outputPorts="1" inputPorts="2"
                         contains="backend=capture"/>
    <assert-midi-options contains="out[0]=Capture (in-memory test port)"/>
    <assert-midi-options contains="in[0]=Computer keyboard id=keyboard"/>
    <assert-midi-options contains="in[1]=Capture (in-memory test port) id=capture"/>
    <!-- The capture port CAN create a virtual port, so the offer is enabled.
         On WinMM it would read virtual=no - gated on the capability the backend
         reports, never on the platform (tw/devices CONTRACT inv. 18). -->
    <assert-midi-options contains="virtual=yes"/>
    <!-- Nothing is SELECTED here, so nothing is opened by this page. Since
         proposal 21 L2 a selected port IS opened on apply (and a track that
         names one opens it on arm), which is what makes the page active; the
         default state is still "listed, not listening". -->
    <assert-midi-options contains="selected=0"/>

    <!-- Defaults, straight out of SOpt::def. -->
    <assert-midi-options contains="offsetMs=0"/>
    <assert-midi-options contains="chaseNoteOns=0"/>

    <!-- A written setting PERSISTS and the page reads it back. -->
    <set-option key="midi/outOffsetMs" value="120"/>
    <assert-midi-options contains="offsetMs=120"/>
    <assert-midi-options absent="offsetMs=0"/>

    <set-option key="midi/outOffsetMs" value="0"/>
    <assert-midi-options contains="offsetMs=0"/>
  </actions>

  <assertions>
    <assert-track-count equals="0"/>
  </assertions>

</SActionScript>
