<?xml version="1.0" encoding="UTF-8"?>
<!--
  QBX-284 gap 1: the undo of dissolve-arrangement brings back EVERY asset the
  arrangement owned, not only the one named after it.

  "Loop" windows the Drums root but is not named Drums. The dissolve
  unregisters every asset over the root; the rebuild inverse QBX-270 shipped
  (an extract-arrangement) re-made only an asset NAMED after the arrangement,
  so Loop was gone after the undo. The undo now re-registers the ORIGINAL
  asset objects the dissolve kept alive, so Loop comes back with its window.

  Loop's existence and window are read at the end, after a second undo, by
  placing it on the master's lane 0 and reading the placement's window.

  assert-ref-count reads the root's and the asset's reference counts before
  the dissolve and after every undo, and they must not move: the dissolve
  PINS both for its undo, and an undo that forgot to drop its pin would leave
  every count one higher and the arrangement never destroyable again.

  drain-pending-deletes runs between the dissolve and its undo: the dissolve
  drops the registry's references, and without the drain a test-case run
  never delivers DeferredDelete, so a build that kept nothing alive for the
  undo would pass.
-->
<SActionScript version="1" name="dissolve_undo_keeps_other_assets">

  <setup project="new"/>

  <actions>
    <add-track index="-1"/>
    <set-track-name trackPath="0" name="Keep"/>
    <create-arrangement name="Drums"/>
    <add-track arrangement="Drums" index="-1"/>
    <set-track-name trackPath="Drums:0" name="Kick"/>
    <add-sample trackPath="Drums:0" filePath="../test_sawtooth.wav" timePos="0"/>
    <create-asset container="Drums:" startOffset="0" duration="48000" assetName="Loop"/>

    <assert-ref-count arrangement="Drums" refs="2"/>
    <assert-ref-count asset="Loop" refs="1"/>

    <dissolve-arrangement name="Drums"/>
    <assert-arrangements names=""/>
    <assert-track-count arrangement="" count="2"/>
    <place-asset assetName="Loop" trackPath="0" timePos="0" expectReject="true"/>

    <drain-pending-deletes/>

    <undo/>
    <assert-arrangements names="Drums" trackCounts="1"/>
    <assert-ref-count arrangement="Drums" refs="2"/>
    <assert-ref-count asset="Loop" refs="1"/>
    <assert-track-name trackPath="Drums:0" name="Kick"/>
    <assert-track-count arrangement="" count="1"/>
    <assert-track-name trackPath="0" name="Keep"/>

    <redo/>
    <assert-arrangements names=""/>
    <assert-track-count arrangement="" count="2"/>
    <assert-track-name trackPath="1" name="Kick"/>
    <place-asset assetName="Loop" trackPath="0" timePos="0" expectReject="true"/>

    <!-- A second undo, then the asset itself: it is back, with its window.
         Last, so the placement it makes needs no undo of its own. The
         redo re-pinned, so drain again before this undo too. -->
    <drain-pending-deletes/>
    <undo/>
    <assert-arrangements names="Drums"/>
    <assert-ref-count arrangement="Drums" refs="2"/>
    <assert-ref-count asset="Loop" refs="1"/>
    <place-asset assetName="Loop" trackPath="0" timePos="0"/>
    <assert-clip-window clip="0,0" startTime="0" duration="48000"/>
  </actions>

</SActionScript>
