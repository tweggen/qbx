<?xml version="1.0" encoding="UTF-8"?>
<!--
  QBX-286: MONITORING AN ARRANGEMENT'S TRACK LEAVES THE MASTER PLAYING, EVEN
  WHEN THE MASTER IS NOT LINEAR.

  A master lane with an insert normally makes a live lane a CLOSURE: the pump
  renders the master and the RT pops the ring only (proposal 45 M3). That is
  right only when a MASTER track has left the frozen sum. When every live
  member is held by an arrangement nothing has left it, so the plan keeps the
  linear split and the RT keeps adding the ring to the root page - which
  already carries the master's chain. Without that, the root page is dropped
  and the master's own material goes silent the moment an arrangement track
  is armed.

  Master track 0 plays a held A4 at velocity 40 through the master's gain of
  2.0: (40/127)/sqrt(2) x 2 = 0.445420. Arr:0 is armed and monitored, and
  nothing is played into it, so the closed form is the master's alone.
-->
<SActionScript version="1" name="live_arrangement_master_plays">

  <setup project="new"/>

  <actions>
    <add-track index="-1"/>
    <insert-plugin trackPath="0" slotIndex="0"
                   format="clap" uid="tw.test.clap.sine"
                   name="Smaragd Test Sine" vendor="Smaragd"
                   path="twtestclap.clap" nIn="0" nOut="2"
                   isInstrument="true"/>
    <insert-midi-clip trackPath="0" timePos="0" duration="15360" name="Held"/>
    <add-note clip="0,0" tick="0" dur="15360" key="69" velocity="40" channel="0"/>
    <insert-plugin trackPath="$master" slotIndex="0"
                   format="clap" uid="tw.test.clap.gain"
                   name="Smaragd Test Gain" vendor="Smaragd"
                   path="twtestclap.clap" nIn="2" nOut="2"/>
    <set-plugin-param trackPath="$master" slotIndex="0" paramId="0" value="2.0"/>

    <create-arrangement name="Arr"/>
    <add-track arrangement="Arr" index="-1"/>
    <insert-plugin trackPath="Arr:0" slotIndex="0"
                   format="clap" uid="tw.test.clap.sine"
                   name="Smaragd Test Sine" vendor="Smaragd"
                   path="twtestclap.clap" nIn="0" nOut="2"
                   isInstrument="true"/>
    <set-track-input trackPath="Arr:0" input="midi:capture:any"/>
    <set-monitor-mode trackPath="Arr:0" mode="on"/>
    <arm-track trackPath="Arr:0" armed="1"/>

    <toggle-playback play="1"/>
    <wait-playhead minAdvance="96000" timeoutMs="30000"/>
    <assert-input-meter trackPath="Arr:0" contains="live=on tracks=1 sources=1"/>
    <dump-playback-capture filename="arr_master_plays.wav" minFrames="96000"/>
    <!-- 0.445420 +-4 % -->
    <assert-audio-energy filename="arr_master_plays.wav" channel="0"
                         anchorOnset="1" startFrame="8000" frameCount="20000"
                         minRms="0.42760" maxRms="0.46324"/>

    <toggle-playback play="0"/>
    <arm-track trackPath="Arr:0" armed="0"/>
    <wait-ms ms="400"/>
    <assert-render-policy liveThreadRefusals="0" liveOwnedRefusals="0"/>
  </actions>

  <assertions>
    <assert-track-count equals="1"/>
  </assertions>

</SActionScript>
