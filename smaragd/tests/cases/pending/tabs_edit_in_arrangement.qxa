<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  NOT REGISTERED, AND CURRENTLY FAILING. This directory is not covered by the
  tests/cases/*.qxa glob (the same convention tests/cases/xproc/ uses).

  WHAT WORKS: the tab opens, dedups, activates and closes; and the submit
  funnel roots correctly, which is the whole of M8b doing its job. Verified by
  instrumentation: the drag made with the Drums tab active submits resize-clip
  with pathRoot "Drums", and the one made with the master tab active submits
  with an empty root.

  WHAT DOES NOT: the Drums-side drag submits, correctly rooted, and the clip is
  not resized.

  TWO HYPOTHESES WERE TESTED AND BOTH ARE WRONG. It is NOT a layout problem.
  The first guess was that a tab page added mid-script is never laid out (a
  .qxa runs its actions back to back without returning to the event loop), so
  the pixel math would be meaningless; giving the new page the master's
  geometry did not help, and neither did activating its layout synchronously.
  MEASURED, both views compute IDENTICAL coordinates:

      root=""      viewSize=300x150 canvas=150x112 sx=0 ex=120 x0=119 x1=60
      root="Drums" viewSize=300x150 canvas=150x112 sx=0 ex=120 x0=119 x1=60

  So the gesture geometry is the same on both sides and the master one works.
  Whatever differs is AFTER the synthesised mouse events - in the Drums view's
  handling of them, or in what resize-clip resolves once it has them. That is
  where the next look should start; do not re-test the layout theory.

  Register it (move it up one directory) once that is answered.
  ============================================================================
-->
<SActionScript version="1" name="tabs_edit_in_arrangement">

  <setup project="new"/>

  <actions>
    <add-track index="-1"/>
    <set-track-name trackPath="0" name="MasterLane"/>
    <add-sample trackIndex="0" filePath="../test_sawtooth.wav" timePos="0"/>

    <create-arrangement name="Drums"/>
    <add-track arrangement="Drums" index="-1"/>
    <set-track-name trackPath="Drums:0" name="DrumLane"/>
    <add-sample trackPath="Drums:0" filePath="../test_sawtooth.wav" timePos="0"/>

    <!-- One tab so far. -->
    <assert-tab-set names="Arrangement" active="Arrangement"/>

    <!-- Open the arrangement in its own tab, and make it the active one. -->
    <open-arrangement-tab name="Drums"/>
    <assert-tab-set names="Arrangement,Drums" active="Drums"/>

    <!-- Opening it TWICE focuses the one tab rather than spawning a second
         editor that would fight the first over the same model. -->
    <open-arrangement-tab name="Drums"/>
    <assert-tab-set names="Arrangement,Drums" active="Drums"/>

    <!-- A REAL ARRANGER GESTURE, with the Drums tab active: drag the clip's
         right edge. It must resize the clip in DRUMS. -->
    <assert-clip-window clip="Drums:0,0" duration="192000"/>
    <assert-clip-window clip="0,0" duration="192000"/>
    <drag-clip-edge track="0" clip="0" edge="end" toTime="96000"/>
    <assert-clip-window clip="Drums:0,0" duration="192000" expectReject="true"/>
    <assert-clip-window clip="0,0" duration="192000"/>

    <!-- ...and its UNDO lands in Drums too, not in the master. -->
    <undo/>
    <assert-clip-window clip="Drums:0,0" duration="192000"/>
    <assert-clip-window clip="0,0" duration="192000"/>

    <!-- Back on the master tab, the same gesture edits the MASTER. -->
    <activate-tab name="Arrangement"/>
    <assert-tab-set names="Arrangement,Drums" active="Arrangement"/>
    <drag-clip-edge track="0" clip="0" edge="end" toTime="96000"/>
    <assert-clip-window clip="0,0" duration="192000" expectReject="true"/>
    <assert-clip-window clip="Drums:0,0" duration="192000"/>
    <undo/>
    <assert-clip-window clip="0,0" duration="192000"/>

    <!-- Closing a tab destroys the VIEW and nothing else. -->
    <close-arrangement-tab name="Drums"/>
    <assert-tab-set names="Arrangement" active="Arrangement"/>
    <assert-arrangements names="Drums" trackCounts="1"/>
    <assert-track-name trackPath="Drums:0" name="DrumLane"/>
  </actions>

</SActionScript>
