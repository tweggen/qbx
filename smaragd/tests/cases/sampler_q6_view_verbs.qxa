<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proposal 56 Q6 (QBX-272): the instance state the landing rule reads, and
  place-sampler-recording driven directly. Records nothing in real time.

  The author's answers of 2026-11-02 (nassau-digital DESIGN 13):
    1. the view, the selected pad and its bank are model state of the
       SSamplerProgram, saved in qbx's own element and never in the program;
    2. set-sampler-view (view, padBank, pad) is a real undoable verb, brought
       forward from Q7;
    3. the last key played is the last note-on the instance's device MIDI
       input tap saw: live, NOT saved, set by injected MIDI here;
    4. the record input sits beside the view state (set-sampler-record-input).

  Gated here: undo and redo of both verbs, their refusals (each changing
  nothing), save and reload (the state survives, the last key does not), the
  last key from injected MIDI (the LAST note-on, never a note-off or a
  velocity-0 note-on), and place-sampler-recording's own refusals and an
  explicit target. The load replaces the project, so it comes last.
-->
<SActionScript version="1" name="sampler_q6_view_verbs">

  <setup project="new"/>

  <actions>
    <add-track index="-1"/>
    <insert-plugin trackPath="0" slotIndex="0"
                   format="tw" uid="tw.native.nassaudigital"
                   name="NassauDigital" vendor="Nassau"
                   path="" nIn="0" nOut="2"/>

    <!-- ................................................ set-sampler-view -->
    <!-- A refused view creates no program object (invariant 4). -->
    <set-sampler-view trackPath="0" slotIndex="0" view="grid" expectReject="true"/>
    <assert-sampler-program trackPath="0" slotIndex="0" exists="0"/>

    <set-sampler-view trackPath="0" slotIndex="0" view="pad" padBank="2" pad="3"/>
    <assert-sampler-program trackPath="0" slotIndex="0" exists="1" zones="0" view="pad"
                            padBank="2" pad="3" padKey="71"/>
    <undo/>
    <assert-sampler-program trackPath="0" slotIndex="0" view="key" padBank="0" pad="0" padKey="36"/>
    <redo/>
    <assert-sampler-program trackPath="0" slotIndex="0" view="pad" padBank="2" pad="3" padKey="71"/>

    <!-- One attribute alone keeps the others. -->
    <set-sampler-view trackPath="0" slotIndex="0" pad="15"/>
    <assert-sampler-program trackPath="0" slotIndex="0" view="pad" padBank="2" pad="15" padKey="83"/>
    <undo/>
    <assert-sampler-program trackPath="0" slotIndex="0" view="pad" padBank="2" pad="3" padKey="71"/>

    <!-- Refusals, each changing nothing. Bank 5 holds pads 0..11 only: pad 12
         would be key 128. -->
    <set-sampler-view trackPath="0" slotIndex="0" padBank="6" expectReject="true"/>
    <set-sampler-view trackPath="0" slotIndex="0" padBank="5" pad="12" expectReject="true"/>
    <set-sampler-view trackPath="0" slotIndex="0" pad="16" expectReject="true"/>
    <set-sampler-view trackPath="0" slotIndex="0" pad="-2" expectReject="true"/>
    <set-sampler-view trackPath="0" slotIndex="0" expectReject="true"/>
    <assert-sampler-program trackPath="0" slotIndex="0" view="pad" padBank="2" pad="3"/>
    <set-sampler-view trackPath="0" slotIndex="0" padBank="5" pad="11"/>
    <assert-sampler-program trackPath="0" slotIndex="0" padKey="127"/>
    <undo/>

    <!-- The view state is not the program: the program text is untouched. -->
    <assert-sampler-program trackPath="0" slotIndex="0" xmlContains="&lt;NassauDigitalProgram"/>

    <!-- ........................................ set-sampler-record-input -->
    <set-sampler-record-input trackPath="0" slotIndex="0" input="audio:qxa-record-input:3"/>
    <assert-sampler-program trackPath="0" slotIndex="0" recordInput="audio:qxa-record-input:3"/>
    <undo/>
    <assert-sampler-program trackPath="0" slotIndex="0" recordInput=""/>
    <redo/>
    <assert-sampler-program trackPath="0" slotIndex="0" recordInput="audio:qxa-record-input:3"/>
    <set-sampler-record-input trackPath="0" slotIndex="0" input="midi:capture:any" expectReject="true"/>
    <set-sampler-record-input trackPath="0" slotIndex="0" input="audio:qxa-record-input:0" expectReject="true"/>
    <set-sampler-record-input trackPath="0" slotIndex="0" input="audio:qxa-record-input" expectReject="true"/>
    <set-sampler-record-input trackPath="0" slotIndex="0" expectReject="true"/>
    <assert-sampler-program trackPath="0" slotIndex="0" recordInput="audio:qxa-record-input:3"/>

    <!-- ........................................ the last key played -->
    <assert-sampler-program trackPath="0" slotIndex="0" lastKey="-1"/>
    <set-track-input trackPath="0" input="midi:capture:any"/>
    <midi-in-event kind="noteon" key="50" velocity="100" channel="0"/>
    <wait-ms ms="200"/>
    <assert-sampler-program trackPath="0" slotIndex="0" lastKey="50"/>
    <!-- A note-off and a velocity-0 note-on are not keys played. -->
    <midi-in-event kind="noteoff" key="51" channel="0"/>
    <midi-in-event kind="noteon" key="70" velocity="0" channel="0"/>
    <wait-ms ms="200"/>
    <assert-sampler-program trackPath="0" slotIndex="0" lastKey="50"/>
    <!-- The LAST note-on wins. -->
    <midi-in-event kind="noteon" key="62" velocity="90" channel="3"/>
    <midi-in-event kind="noteon" key="64" velocity="90" channel="3"/>
    <wait-ms ms="200"/>
    <assert-sampler-program trackPath="0" slotIndex="0" lastKey="64"/>
    <!-- A channel the track's input does not take is not played on it. -->
    <set-track-input trackPath="0" input="midi:capture:2"/>
    <midi-in-event kind="noteon" key="40" velocity="90" channel="0"/>
    <wait-ms ms="200"/>
    <assert-sampler-program trackPath="0" slotIndex="0" lastKey="64"/>
    <midi-in-event kind="noteon" key="41" velocity="90" channel="2"/>
    <wait-ms ms="200"/>
    <assert-sampler-program trackPath="0" slotIndex="0" lastKey="41"/>

    <!-- ............................ place-sampler-recording, driven directly -->
    <add-zone trackPath="0" slotIndex="0" keyLo="36" keyHi="36" rootKey="36">
      <layer src="file:../test_autosaw.wav"/>
    </add-zone>
    <assert-sampler-program trackPath="0" slotIndex="0" capture="one"/>
    <!-- Refusals, each changing nothing: no file, a file that does not open,
         an offset past its end, a bad target. -->
    <place-sampler-recording trackPath="0" slotIndex="0" filePath="" expectReject="true"/>
    <place-sampler-recording trackPath="0" slotIndex="0" filePath="../no_such_take.wav" expectReject="true"/>
    <place-sampler-recording trackPath="0" slotIndex="0" filePath="../test_stereo.wav"
                             srcOffset="144000" expectReject="true"/>
    <place-sampler-recording trackPath="0" slotIndex="0" filePath="../test_stereo.wav"
                             target="map" expectReject="true"/>
    <assert-sampler-program trackPath="0" slotIndex="0" equalsCaptured="one" assetAbsent="Recording 1"/>

    <!-- The view is pad (bank 2, pad 3: key 71): with no target the pad wins. -->
    <place-sampler-recording trackPath="0" slotIndex="0" filePath="../test_stereo.wav"
                             srcOffset="1000" length="48000"/>
    <assert-sampler-program trackPath="0" slotIndex="0" zoneIds="1;3"
                            scope="zone" id="3" attr="keyLo" value="71"/>
    <assert-sampler-program trackPath="0" slotIndex="0" scope="zone" id="3" attr="rootKey" value="71"/>
    <assert-sampler-program trackPath="0" slotIndex="0" scope="layer" id="4" attr="start" value="1000"/>
    <assert-sampler-program trackPath="0" slotIndex="0" scope="layer" id="4" attr="end" value="49000"/>
    <undo/>
    <assert-sampler-program trackPath="0" slotIndex="0" equalsCaptured="one" ignoreNextId="1"
                            assetAbsent="Recording 1"/>
    <!-- An explicit key target on a program with zones: a one-key zone there. -->
    <place-sampler-recording trackPath="0" slotIndex="0" filePath="../test_stereo.wav"
                             target="key" key="40"/>
    <assert-sampler-program trackPath="0" slotIndex="0" zoneIds="1;5"
                            scope="zone" id="5" attr="keyHi" value="40"/>
    <undo/>

    <!-- ................................................ save and reload -->
    <save-project path="../../build/sampler_q6_view_verbs.qxp"/>
    <load-project path="../../build/sampler_q6_view_verbs.qxp"/>
    <assert-sampler-program trackPath="0" slotIndex="0" view="pad" padBank="2" pad="3"
                            recordInput="audio:qxa-record-input:3" lastKey="-1"
                            equalsCaptured="one" ignoreNextId="1"/>
    <!-- The state is not in the program text (never exported). -->
    <assert-sampler-program trackPath="0" slotIndex="0" xmlContains="recordInput"
                            expectReject="true"/>
    <!-- Edits after the reload still work, and undo. -->
    <set-sampler-view trackPath="0" slotIndex="0" view="key"/>
    <assert-sampler-program trackPath="0" slotIndex="0" view="key" padBank="2" pad="3"/>
    <undo/>
    <assert-sampler-program trackPath="0" slotIndex="0" view="pad"/>
  </actions>

  <assertions>
    <assert-track-count equals="1"/>
  </assertions>

</SActionScript>
