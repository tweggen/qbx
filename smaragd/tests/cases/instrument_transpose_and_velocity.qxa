<?xml version="1.0" encoding="UTF-8"?>
<SActionScript version="1" name="instrument_transpose_and_velocity">

  <!-- Proposal 37 P3b, AC4: THE CLIP'S OWN MODIFIERS REACH THE INSTRUMENT.

       `transpose` and `velocityScale` are per-CLIP modifiers baked into
       SMidiCut's snapshot sequence (the content is shared, so they cannot be
       edits to it). They therefore travel exactly the same road the notes do -
       clip set -> feed -> the slot-0 processor - and the sine fixture turns
       each one into a number with no room to argue:

           transpose = +12       one octave      f -> 2 f
           velocityScale = 0.5   half velocity   rms -> rms / 2

       C4 is 261.626 Hz, so +12 is C5 at 523.251 Hz (+/-1 Hz). Velocity 100
       gives (100/127)/sqrt(2) = 0.556769; at scale 0.5 it is 0.278385. The two
       bands are 100 % apart, so neither can be passed by the other's audio.

       Both are set in ONE set-midi-cut - it is an ABSOLUTE verb, like every
       other clip modifier - and both undo together. -->

  <setup project="new"/>

  <actions>
    <add-track index="-1"/>

    <insert-plugin trackPath="0" slotIndex="0"
                   format="clap" uid="tw.test.clap.sine"
                   name="Smaragd Test Sine" vendor="Smaragd"
                   path="twtestclap.clap" nIn="0" nOut="2"
                   isInstrument="true"/>

    <insert-midi-clip trackPath="0" timePos="0" duration="1920" name="One"/>
    <add-note clip="0,0" tick="0" dur="1920" key="60" velocity="100" channel="0"/>

    <render filename="itv_plain.wav" format="wav" quality="10" durationSec="1.0"/>
    <assert-audio-frequency filename="itv_plain.wav" startFrame="0" frameCount="48000"
                            channel="0" minHz="260.626" maxHz="262.626"/>
    <assert-audio-energy filename="itv_plain.wav" startFrame="0" frameCount="48000"
                         channel="0" minRms="0.54007" maxRms="0.57347"/>

    <set-midi-cut clip="0,0" transpose="12" velocityScale="0.5"/>

    <render filename="itv_edited.wav" format="wav" quality="10" durationSec="1.0"/>
    <!-- an octave up -->
    <assert-audio-frequency filename="itv_edited.wav" startFrame="0" frameCount="48000"
                            channel="0" minHz="522.251" maxHz="524.251"/>
    <!-- half the level: 0.278385, +/-3 % -->
    <assert-audio-energy filename="itv_edited.wav" startFrame="0" frameCount="48000"
                         channel="0" minRms="0.27003" maxRms="0.28674"/>

    <!-- ...and it undoes back to exactly the first render. -->
    <undo count="1"/>
    <render filename="itv_undone.wav" format="wav" quality="10" durationSec="1.0"/>
    <assert-file-identical actual="itv_undone.wav" expected="itv_plain.wav"/>
  </actions>

  <assertions>
    <assert-track-count equals="1"/>
  </assertions>

</SActionScript>
