<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proposal 38 GATE 5b, AC 14/15 (T13, §B.8 rule 2): a secret must never reach
  a log line, an exception message or describe() - neither as the plaintext
  itself NOR as the base64 an HTTP Basic Authorization header carries. The
  second half is the one that actually bites: `Authorization: Basic
  <base64(user:password)>` leaks base64(user:password), not the password, so
  a case that greps only for the literal would pass while the credential sat
  in the log in plain sight.

  `media-account-redaction-drive` is ONE self-contained driving action
  (starts a throwaway in-process stub, saves a REAL account through
  SMediaAccountManager::setAccount() - exercising SSettings + SSecretStore
  for real, which is what "sets a password" needs to mean here - then issues
  a PROPFIND that succeeds and one that gets a 401) so the whole flow sits
  inside ONE assert-log window (SAssertLogAction::beginAction()'s rule: the
  window is "since the action immediately before this assert-log started").

  Deliberately does NOT assert `"Basic "` absent: that would forbid the
  correctly redacted `Authorization: Basic <redacted>` line and force
  redaction to erase the scheme name to satisfy its own gate (§B.8 rule 2).

  RUN_SERIAL and SMARAGD_SECRET_BACKEND=dpapi for the same reason as
  media_options_page.qxa: the drive saves the account with Remember ON, which
  writes real ciphertext into the shared smaragd.ini. Owns and restores every
  key under media/nextcloud/qxatest/*.
-->
<SActionScript version="1" name="media_secret_redaction">

  <setup project="new"/>

  <actions>
    <!-- Defensive: a previous run that failed mid-script could have left
         "qxatest" behind. -->
    <remove-media-account accountId="qxatest"/>

    <media-account-redaction-drive accountId="qxatest" user="qxauser"
                                   password="Zk9mQxaRedactMe42" remember="1"/>

    <!-- The password literal reaches no log record at all. minCount="0" is
         REQUIRED alongside maxCount="0" - assert-log's own default minCount
         is 1 ("at least one match"), so omitting it here would make this
         assertion demand exactly the leak it exists to forbid. -->
    <assert-log contains="Zk9mQxaRedactMe42" minCount="0" maxCount="0"/>
    <!-- Nor does base64("qxauser:Zk9mQxaRedactMe42") - the exact bytes an
         "Authorization: Basic ..." header would carry on the wire. This is
         the assertion that actually bites: a case that checked only the
         plaintext would still pass with the credential sitting in the log,
         base64-encoded, in plain sight. -->
    <assert-log contains="cXhhdXNlcjpaazltUXhhUmVkYWN0TWU0Mg==" minCount="0" maxCount="0"/>

    <!-- describe() reports the STATUS word, never the value (AC 15). -->
    <assert-media-options contains="password=set"/>
    <assert-media-options absent="Zk9mQxaRedactMe42"/>
    <assert-media-options absent="cXhhdXNlcjpaazltUXhhUmVkYWN0TWU0Mg=="/>

    <remove-media-account accountId="qxatest"/>
    <assert-media-options absent="qxatest"/>
    <!-- QSettings::IniFormat only brackets the FIRST path component, so
         "media/nextcloud/qxatest/*" lands under "[media]" as keys spelled
         "nextcloud\qxatest\..." - that disk spelling, not a "[section]"
         header, is what a raw-file check has to look for. -->
    <assert-settings-file absent="nextcloud\qxatest\"/>
  </actions>

  <assertions>
    <assert-track-count equals="0"/>
  </assertions>

</SActionScript>
