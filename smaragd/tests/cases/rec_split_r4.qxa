<?xml version="1.0" encoding="UTF-8"?>
<!--
  Plan 53 §3.3's matrix, CELL R4, under mode `takes-split` (QBX-172).
  Kp, Kc and Km on three tracks of one project, driven through
  `place-recording mode="takes-split"` directly, so the whole case is
  arithmetic: no capture device, no transport, no wall-clock jitter anywhere.

  R4 means the child STARTS WITH the pass and runs PAST it (`a == s`, `b < e`).

  One cut, at `b`. The piece before it KEEPS the child's index and
  receives the pass; the piece after `b` is the appended one and carries
  a SHIFTED map. The pass covers `[a, b)` exactly, so there is no plain
  cut anywhere in the result.

  GEOMETRY, the same on all three lanes. test_sawtooth.wav is 192000 frames
  (4 s at 48 kHz), so every number below is a closed form:

      O = [96000, 192000)
      R = [96000, 144000)      the pass, 48000 frames

  and the expected result is

      child 0   [96000   144000)   the column: take 0 = the old piece, the pass active on top
      child 1   [144000  192000)   a surviving PIECE of O, srcOffset 48000 (a column still, on Kc and Km)
      child 2   does not exist

  THE AFTER-`b` PIECE IS WHERE THE SHIFT SHOWS. O's map is
  `0:1;24000:0;72000:1` over column frames 0..96000 and the cut is at
  48000, so the piece after `b` must come out as `0:0;24000:1` — its
  opening segment is whatever sounded at the cut (take 0, from the
  segment at 24000) and the segment at 72000 moves down to 24000. A map
  left UNSHIFTED would name frame 72000 on a piece only 48000 frames
  long and never be reached.

  WHY THIS FAILS ON main: `takes-split` is a planner that REFUSES in that
  build (QBX-171 shipped it as `NotYetImplemented`, deliberately loud rather
  than falling back to the legacy shape), so `place-recording` is REJECTED and
  every assertion after it fails. Plan 53's P1 section predicted a different
  reason — "`mode=` is ignored by `readXml`, so the old planner runs" — which
  was true before M0 and is not any more.

  THE ASSERTIONS STILL DISCRIMINATE THE MODE, which is why they are not
  weakened to "the verb succeeded": `LegacyTakes` gives this lane a different
  child count and a different shape, so a silent fallback to `takes` would be
  caught here and not merely by the refusal.

  THE ACTIVE TAKE IS NOT THE MAPPED TAKE on Km, deliberately: an empty map
  MEANS "ask activeTake_", so a case whose active take is the one its map
  selects passes identically against a dropped map
  (comp_map_survives_split.qxa makes the same point at length).
-->
<SActionScript version="1" name="rec_split_r4">

  <setup project="new"/>

  <actions>
    <snap-to-grid-disable/>
    <add-track index="-1"/>
    <add-track index="-1"/>
    <add-track index="-1"/>

    <!-- ===== Kp: a plain clip ===== -->
    <place-clip trackPath="0" filePath="../test_sawtooth.wav"
                timePos="96000" startOffset="0" duration="96000"/>
    <assert-clip-window clip="0,0" startTime="96000" duration="96000"
                        startOffset="0"/>
    <assert-take-column clip="0,0" shape="none"/>

    <!-- ===== Kc: a direct column, no comp map ===== -->
    <place-clip trackPath="1" filePath="../test_sawtooth.wav"
                timePos="96000" startOffset="0" duration="96000"/>
    <add-take clip="1,0" filePath="../test_sawtooth.wav" startOffset="96000"/>
    <select-take clip="1,0" take="0"/>
    <assert-take-column clip="1,0" shape="direct" takes="2" activeTake="0"
                        comp=""/>

    <!-- ===== Km: a direct column WITH a comp map ===== -->
    <place-clip trackPath="2" filePath="../test_sawtooth.wav"
                timePos="96000" startOffset="0" duration="96000"/>
    <add-take clip="2,0" filePath="../test_sawtooth.wav" startOffset="96000"/>
    <!-- select-take CLEARS the map, so it comes before the segments. -->
    <select-take clip="2,0" take="0"/>
    <set-comp-segment clip="2,0" at="0" take="1"/>
    <set-comp-segment clip="2,0" at="24000" take="0"/>
    <set-comp-segment clip="2,0" at="72000" take="1"/>
    <assert-take-column clip="2,0" shape="direct" takes="2" activeTake="0"
                        comp="0:1;24000:0;72000:1"/>

    <!-- ===== THE PASS, same span on every lane ===== -->
    <place-recording trackPath="0" filePath="../test_sawtooth.wav"
                     mode="takes-split" timePos="96000" length="48000"/>
    <place-recording trackPath="1" filePath="../test_sawtooth.wav"
                     mode="takes-split" timePos="96000" length="48000"/>
    <place-recording trackPath="2" filePath="../test_sawtooth.wav"
                     mode="takes-split" timePos="96000" length="48000"/>

    <!-- ===== Kp ===== -->
    <assert-clip-window clip="0,0" startTime="96000" duration="48000"/>
    <assert-take-column clip="0,0" shape="direct" takes="2"
                        activeTake="1" comp=""/>
    <assert-clip-window clip="0,1" startTime="144000" duration="48000"
                        startOffset="48000"/>
    <assert-take-column clip="0,1" shape="none"/>
    <assert-clip-window clip="0,2" expectReject="true"/>

    <!-- ===== Kc ===== -->
    <assert-clip-window clip="1,0" startTime="96000" duration="48000"/>
    <assert-take-column clip="1,0" shape="direct" takes="3"
                        activeTake="2" comp=""/>
    <assert-clip-window clip="1,1" startTime="144000" duration="48000"
                        startOffset="48000"/>
    <assert-take-column clip="1,1" shape="direct" takes="2"
                        activeTake="0" comp=""/>
    <assert-clip-window clip="1,2" expectReject="true"/>

    <!-- ===== Km ===== -->
    <assert-clip-window clip="2,0" startTime="96000" duration="48000"/>
    <assert-take-column clip="2,0" shape="direct" takes="3"
                        activeTake="2" comp=""/>
    <assert-clip-window clip="2,1" startTime="144000" duration="48000"
                        startOffset="48000"/>
    <assert-take-column clip="2,1" shape="direct" takes="2"
                        activeTake="0" comp="0:0;24000:1"/>
    <assert-clip-window clip="2,2" expectReject="true"/>

    <!-- ONE UNDO PER PASS puts each lane back exactly as it was: the whole
         plan of one pass is one composite, so one undo entry per lane. -->
    <undo count="3"/>
    <assert-clip-window clip="0,0" startTime="96000" duration="96000"
                        startOffset="0"/>
    <assert-take-column clip="0,0" shape="none"/>
    <assert-clip-window clip="0,1" expectReject="true"/>
    <assert-clip-window clip="1,0" startTime="96000" duration="96000"/>
    <assert-take-column clip="1,0" shape="direct" takes="2" activeTake="0"
                        comp=""/>
    <assert-clip-window clip="1,1" expectReject="true"/>
    <assert-clip-window clip="2,0" startTime="96000" duration="96000"/>
    <assert-take-column clip="2,0" shape="direct" takes="2" activeTake="0"
                        comp="0:1;24000:0;72000:1"/>
    <assert-clip-window clip="2,1" expectReject="true"/>
  </actions>

  <assertions>
    <assert-track-count equals="3"/>
  </assertions>

</SActionScript>
