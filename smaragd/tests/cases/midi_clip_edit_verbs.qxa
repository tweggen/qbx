<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proposal 36 P1, AC2. Every event verb, each one followed by an EXPLICIT undo
  and the prior assertion - the runner's verify-undo pass compares track counts
  only, so it can see none of this.

  Frames per tick here: 120 BPM, PPQ 960, 48 kHz -> 960 ticks = 24000 frames,
  i.e. exactly 25 frames per tick. Every `at=` below is an exact integer, which
  is the point of D2's exact-rational conversion: there is nothing to round.

  The split is the load-bearing one. It is NON-DESTRUCTIVE (D3): the window is
  narrowed and the SHARED sequence is never edited, so
    - the head keeps the straddling note at its ORIGINAL duration (dur=48000),
    - the head's window end SYNTHESISES the note-off (twEventClipSet, inv. 8) -
      which exists in no table and is only visible through a collect, hence
      kind="noteoff-synth",
    - the tail does NOT re-attack it: a note-on before the window reaches a
      consumer only through the chase set, never as an event.
-->
<SActionScript version="1" name="midi_clip_edit_verbs">

  <setup project="new"/>

  <actions>
    <add-track index="-1"/>
    <insert-midi-clip trackPath="0" timePos="0" duration="3840" name="Notes"/>
    <assert-midi-events clip="0,0" kind="note" count="0"/>

    <!-- ============================== add-note ========================== -->
    <add-note clip="0,0" tick="0" dur="1920" key="60" velocity="100" channel="0"/>
    <assert-midi-events clip="0,0" kind="note" count="1" key="60" at="0"
                        velocity="100"/>
    <!-- Notes are stored WITH their length: 1920 ticks = 48000 frames. -->
    <assert-midi-events clip="0,0" contains="dur=48000"/>
    <undo count="1"/>
    <assert-midi-events clip="0,0" kind="note" count="0"/>
    <add-note clip="0,0" tick="0" dur="1920" key="60" velocity="100" channel="0"/>
    <add-note clip="0,0" tick="960" dur="480" key="64" velocity="80" channel="0"/>
    <assert-midi-events clip="0,0" kind="note" count="2"/>

    <!-- ============================== set-notes ========================= -->
    <!-- ABSOLUTE new note state; non-note events survive it (there are none
         here yet, so this is the pure form). -->
    <set-notes clip="0,0">
      <n tick="1920" dur="480" key="67" velocity="90" channel="0"/>
    </set-notes>
    <assert-midi-events clip="0,0" kind="note" count="1" key="67" at="48000"/>
    <undo count="1"/>
    <assert-midi-events clip="0,0" kind="note" count="2"/>
    <assert-midi-events clip="0,0" kind="note" count="1" key="64" at="24000"/>

    <!-- ============================= remove-note ======================== -->
    <remove-note clip="0,0" tick="960" key="64" channel="0"/>
    <assert-midi-events clip="0,0" kind="note" count="1" key="60"/>
    <undo count="1"/>
    <assert-midi-events clip="0,0" kind="note" count="2"/>

    <!-- ============================== add-event ========================= -->
    <add-event clip="0,0" kind="cc" tick="480" channel="0" p="7" v="64"/>
    <assert-midi-events clip="0,0" kind="cc" count="1" at="12000"/>
    <!-- A note edit must not disturb the controllers, and vice versa. -->
    <assert-midi-events clip="0,0" kind="note" count="2"/>
    <undo count="1"/>
    <assert-midi-events clip="0,0" kind="cc" count="0"/>

    <!-- =========================== quantize-notes ======================= -->
    <add-note clip="0,0" tick="1930" dur="240" key="72" velocity="90" channel="0"/>
    <assert-midi-events clip="0,0" kind="note" count="1" key="72" at="48250"/>
    <!-- 1/16 at PPQ 960 = 240 ticks; 1930 rounds to slot 8 = 1920 = 48000 fr. -->
    <quantize-notes clip="0,0" grid="1/16" strength="1.0" swing="0"/>
    <assert-midi-events clip="0,0" kind="note" count="1" key="72" at="48000"/>
    <undo count="1"/>
    <assert-midi-events clip="0,0" kind="note" count="1" key="72" at="48250"/>
    <remove-note clip="0,0" tick="1930" key="72" channel="0"/>
    <assert-midi-events clip="0,0" kind="note" count="2"/>

    <!-- ============================ set-midi-cut ======================== -->
    <!-- Per-CLIP modifiers: the shared sequence is untouched, the window's
         frame-domain snapshot is rebuilt. -->
    <set-midi-cut clip="0,0" transpose="12" velocityScale="0.5" channel="1"/>
    <assert-midi-events clip="0,0" kind="note" count="1" key="72" at="0"
                        velocity="50" channel="1"/>
    <undo count="1"/>
    <assert-midi-events clip="0,0" kind="note" count="1" key="60" at="0"
                        velocity="100" channel="0"/>

    <!-- =============================== split =========================== -->
    <split-clip clip="0,0" splitTime="24000"/>
    <!-- HEAD: the straddling note, at its ORIGINAL duration. -->
    <assert-midi-events clip="0,0" kind="note" count="1" key="60" at="0"/>
    <assert-midi-events clip="0,0" contains="dur=48000"/>
    <!-- ... released at the window end by a SYNTHESISED note-off. -->
    <assert-midi-events clip="0,0" kind="noteoff-synth" count="1" at="24000"
                        key="60"/>
    <!-- TAIL: the note that started inside it, and NOT the straddling one. -->
    <assert-midi-events clip="0,1" kind="note" count="1" key="64" at="0"/>
    <assert-midi-events clip="0,1" kind="note" key="60" count="0"/>
    <undo count="1"/>
    <assert-midi-events clip="0,0" kind="note" count="2"/>

    <!-- ===================== resize-clip: rate ========================== -->
    <!-- rate 2 stretches the CLIP's time map: every note's frame position
         doubles while the shared sequence keeps its ticks. -->
    <resize-clip clip="0,0" startTime="0" srcStart="0" duration="192000"
                 loopLength="0" stretch="2/1"/>
    <assert-midi-events clip="0,0" kind="note" count="1" key="64" at="48000"/>
    <assert-midi-events clip="0,0" kind="note" count="1" key="60" at="0"/>
    <undo count="1"/>
    <assert-midi-events clip="0,0" kind="note" count="1" key="64" at="24000"/>

    <!-- ===================== resize-clip: slip ========================== -->
    <!-- The anchor crosses in the CONTENT's own units (ticks), which is the
         one documented exception to "setters take timeline frames". -->
    <resize-clip clip="0,0" startTime="0" srcStart="960" duration="72000"
                 loopLength="0" stretch="1"/>
    <assert-midi-events clip="0,0" kind="note" count="1" key="64" at="0"/>
    <assert-midi-events clip="0,0" kind="note" key="60" count="0"/>
    <undo count="1"/>
    <assert-midi-events clip="0,0" kind="note" count="1" key="60" at="0"/>

    <!-- ===================== resize-clip: loop ========================== -->
    <!-- A 24000-frame segment tiled over 96000 frames. Tiling is only visible
         through a COLLECT, so this reads the track's feed. -->
    <resize-clip clip="0,0" startTime="0" srcStart="0" duration="96000"
                 loopLength="24000" stretch="1"/>
    <assert-midi-events scope="feed" trackPath="0" kind="note" key="60"
                        count="4" startFrame="0" frameCount="96000"/>
    <undo count="1"/>
    <assert-midi-events scope="feed" trackPath="0" kind="note" key="60"
                        count="1" startFrame="0" frameCount="96000"/>

    <!-- ======================= take homogeneity ========================= -->
    <!-- A take is an ALTERNATIVE for one region, so a column that played audio
         or notes depending on which lane is armed is refused (D8b). Last,
         because a refused add-take still leaves the clip wrapped in a stack. -->
    <add-take clip="0,0" filePath="../test_sawtooth.wav" expectReject="true"/>
  </actions>

  <assertions>
    <assert-track-count equals="1"/>
  </assertions>

</SActionScript>
