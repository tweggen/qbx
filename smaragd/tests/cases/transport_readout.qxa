<?xml version="1.0" encoding="UTF-8"?>
<!--
  QBX-215. THE TRANSPORT TOOLBAR SHOWS WHERE THE PLAYHEAD IS AND WHAT THE TIME
  SELECTION SPANS: "pos=▶ <position>|sel=[ <start> – <end> ] (<length>)|mode=",
  read off the labels themselves.

  assert-transport-readout does NOT force a refresh: it only points the
  readout at the project and the active arranger, so every value below
  reached the labels through the signal that should carry it - the locator's,
  the arranger's rangeChanged (live, mid-drag), the project's
  arrangementChanged (tempo) and propertyChanged (ruler mode).

  120 BPM, 48 kHz: one bar is 96000 frames. Bars mode reads bar.beat.tick,
  1-based, a length 0-based. 143 BPM is where a tick-valued position and a
  frame-valued one stop agreeing: the map stores it as 419580 us per quarter,
  one bar is 80559.36 frames, so bar 10 starts at frame 725034.24 and the
  frame a render boundary puts it on is 725034 - which a FLOOR to ticks reads
  as 9.4.959. The readout takes the NEAREST tick.

  Two defences, one of them pinned: the RELEASE's rangeChanged is backed by
  saveRangeToProject()'s propertyChanged, so taking it out alone bites
  nothing; the live, MID-drag rangeChanged has no backup, and the
  press-move section below is what pins it.

  The range keeps its BARS across the tempo change below (QBX-212), so its
  seconds move; range_keeps_bars.qxa gates that rule itself.
-->
<SActionScript version="1" name="transport_readout">

  <setup project="new"/>

  <actions>
    <add-track index="-1"/>
    <assert-transport-readout contains="pos=▶ 1.1.000|sel=[ — ]|mode=bars"/>

    <!-- The playhead. -->
    <set-locator position="96000"/>
    <assert-transport-readout contains="pos=▶ 2.1.000|"/>

    <!-- A range, LIVE: mid-drag, before any release (which also saves the
         range as a project property and would refresh on its own). -->
    <drag-range from="864000" to="1008000" phase="press-move"/>
    <assert-transport-readout contains="|sel=[ 10.1.000 – 11.3.000 ] (1.2.000)|"/>
    <!-- ...and where the release leaves it. -->
    <drag-range from="864000" to="1056000" phase="release"/>
    <assert-transport-readout contains="pos=▶ 2.1.000|sel=[ 10.1.000 – 12.1.000 ] (2.0.000)|mode=bars"/>

    <!-- A tempo edit re-reads every bar, with no locator move to help. -->
    <set-tempo bpm="143"/>
    <assert-transport-readout contains="pos=▶ 2.1.736|sel=[ 10.1.000 – 12.1.000 ] (2.0.000)|"/>

    <!-- The NEAREST tick: bar 10's floored frame reads as bar 10. -->
    <set-locator position="725034"/>
    <assert-transport-readout contains="pos=▶ 10.1.000|"/>
    <assert-transport-readout absent="9.4.959"/>

    <!-- The ruler's other mode: m:ss.mmm for all three. -->
    <set-property key="rulerMode" value='["time"]'/>
    <assert-transport-readout contains="pos=▶ 0:15.105|sel=[ 0:15.105 – 0:18.462 ] (0:03.357)|mode=time"/>

    <!-- A click in the ruler without a drag clears the selection. -->
    <drag-range from="300000" to="300000"/>
    <assert-transport-readout contains="|sel=[ — ]|mode=time"/>
  </actions>

  <assertions>
    <assert-track-count equals="1"/>
  </assertions>

</SActionScript>
