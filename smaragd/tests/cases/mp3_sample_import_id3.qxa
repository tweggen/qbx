<?xml version="1.0" encoding="UTF-8"?>
<!--
  MP3 sample import with an ID3v2 TAG (the tag-skip path in
  twSampleSource::loadSndfile). Same audio as mp3_sample_import.qxa, same RMS
  band; the ONLY difference between the two cases is the 147-byte ID3v2.3 tag
  that test_sawtooth_id3.mp3 carries, so any divergence is tag handling and
  nothing else.

  THIS CASE HANGS FOREVER WITHOUT THE FIX, it does not fail. mpg123 1.33.4 built
  at -O3 for MinGW spins on a literal self-jump inside INT123_parse_new_id3 for
  COMM / TXXX / RVA2 frames (twsamplesource.cc carries the mechanism), and the
  decode runs on the calling thread, so the observable is a CTest TIMEOUT rather
  than a red assertion. Verified failing that way against the pre-fix binary
  before this case was committed.

  Why not just extend mp3_sample_import: test_sawtooth.mp3 has no tag at all, so
  it cannot reach the tag path on any build. The fixture is generated by
  tests/tools/gen_id3_fixture.py, which records why those three frame types and
  not USLT / APIC / text.
-->
<SActionScript version="1" name="mp3_sample_import_id3">

  <setup project="new"/>

  <actions>
    <add-track index="-1"/>

    <add-sample trackIndex="0" filePath="../test_sawtooth_id3.mp3" timePos="0"/>

    <render filename="mp3_sample_import_id3.wav" format="wav" quality="10" durationSec="4.5"/>

    <!-- The same window and the same band as mp3_sample_import: the tag must
         cost the decode nothing at all. -->
    <assert-audio-energy filename="mp3_sample_import_id3.wav"
                         startFrame="2000" frameCount="180000"
                         minRms="0.12" maxRms="0.40"/>

    <assert-audio-peak filename="mp3_sample_import_id3.wav" maxPeak="0.999"/>
  </actions>

  <assertions>
    <assert-track-count equals="1"/>
  </assertions>

</SActionScript>
