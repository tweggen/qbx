<?xml version="1.0" encoding="UTF-8"?>
<!--
  MODE A, CELL R4: the recording STARTS WITH the existing material and ends
  INSIDE it (plan 53 §3.1 and §3.3's R4 row, QBX-180 / P2). The pass is heard
  to `b` and the old material from `b` on - "R to b, then O" - so this is the
  cell that proves the pass does not run on past its own material.

    O = [48000, 240000)   startOffset 0, so sec0..sec3 across four seconds
    R = [48000, 144000)   srcOffset 96000, so sec2 then sec3

  s=a=48000 and e=240000 > b=144000, which is R4. C = [48000, 240000).

  Renders are of the Kp lane only; see rec_union_r3's header.
-->
<SActionScript version="1" name="rec_union_r4">

  <setup project="new"/>

  <actions>
    <add-track index="-1"/>
    <add-track index="-1"/>
    <add-track index="-1"/>

    <place-clip trackPath="0" filePath="../test_sawtooth.wav" timePos="48000"
                startOffset="0" duration="192000"/>

    <place-clip trackPath="1" filePath="../test_sawtooth.wav" timePos="48000"
                startOffset="144000" duration="192000"/>
    <add-take clip="1,0" filePath="../test_sawtooth.wav" startOffset="0"/>

    <place-clip trackPath="2" filePath="../test_sawtooth.wav" timePos="48000"
                startOffset="144000" duration="192000"/>
    <add-take clip="2,0" filePath="../test_sawtooth.wav" startOffset="0"/>
    <set-comp-map clip="2,0">
      <seg at="0" take="0"/>
      <seg at="96000" take="1"/>
    </set-comp-map>

    <assert-take-column clip="1,0" shape="direct" takes="2" activeTake="1"
                        comp="" duration="192000"/>
    <assert-take-column clip="2,0" shape="direct" takes="2" activeTake="1"
                        comp="0:0;96000:1" duration="192000"/>

    <place-recording trackPath="0" filePath="../test_sawtooth.wav"
                     timePos="48000" srcOffset="96000" length="96000"
                     mode="takes"/>
    <place-recording trackPath="1" filePath="../test_sawtooth.wav"
                     timePos="48000" srcOffset="96000" length="96000"
                     mode="takes"/>
    <place-recording trackPath="2" filePath="../test_sawtooth.wav"
                     timePos="48000" srcOffset="96000" length="96000"
                     mode="takes"/>

    <assert-take-column clip="0,0" shape="direct" takes="2" activeTake="1"
                        extents="0-192000;0-96000" comp="0:1;96000:0"
                        duration="192000"/>
    <assert-clip-window clip="0,1" expectReject="true"/>

    <assert-take-column clip="1,0" shape="direct" takes="3" activeTake="2"
                        extents="0-192000;0-192000;0-96000"
                        comp="0:2;96000:1" duration="192000"/>
    <assert-clip-window clip="1,1" expectReject="true"/>

    <!-- Km: the re-entry at 96000 names what O's OWN map said there (take 1),
         which is the "prev = j or O's map from b-a on" of §3.3's R4 Kc/Km
         row. Here that coincides with Kc's answer; r1 and r2 are the cells
         where a transferred map differs from a transferred active take. -->
    <assert-take-column clip="2,0" shape="direct" takes="3" activeTake="2"
                        extents="0-192000;0-192000;0-96000"
                        comp="0:2;96000:1" duration="192000"/>
    <assert-clip-window clip="2,1" expectReject="true"/>

    <set-track-mute trackPath="1" muted="1"/>
    <set-track-mute trackPath="2" muted="1"/>
    <render filename="ru_r4_kp.wav" format="wav" quality="10" durationSec="5.0"/>
    <assert-audio-energy filename="ru_r4_kp.wav" startFrame="0"
                         frameCount="48000" minRms="0.0" maxRms="0.005"/>
    <assert-audio-energy filename="ru_r4_kp.wav" startFrame="48000"
                         frameCount="48000" minRms="0.26" maxRms="0.33"/>
    <assert-audio-energy filename="ru_r4_kp.wav" startFrame="96000"
                         frameCount="48000" minRms="0.37" maxRms="0.44"/>
    <!-- THE RE-ENTRY: O comes back at 144000 with its OWN material (source
         sec2, sec3), not with the pass running on. -->
    <assert-audio-energy filename="ru_r4_kp.wav" startFrame="144000"
                         frameCount="48000" minRms="0.26" maxRms="0.33"/>
    <assert-audio-energy filename="ru_r4_kp.wav" startFrame="192000"
                         frameCount="48000" minRms="0.37" maxRms="0.44"/>

    <select-take clip="0,0" take="0"/>
    <select-take clip="1,0" take="1"/>
    <select-take clip="2,0" take="1"/>
    <assert-take-column clip="0,0" comp="" activeTake="0"/>
    <assert-take-column clip="1,0" comp="" activeTake="1"/>
    <assert-take-column clip="2,0" comp="" activeTake="1"/>

    <render filename="ru_r4_kp_old.wav" format="wav" quality="10"
            durationSec="5.0"/>
    <assert-audio-energy filename="ru_r4_kp_old.wav" startFrame="0"
                         frameCount="48000" minRms="0.0" maxRms="0.005"/>
    <assert-audio-energy filename="ru_r4_kp_old.wav" startFrame="48000"
                         frameCount="48000" minRms="0.05" maxRms="0.085"/>
    <assert-audio-energy filename="ru_r4_kp_old.wav" startFrame="96000"
                         frameCount="48000" minRms="0.15" maxRms="0.21"/>
    <assert-audio-energy filename="ru_r4_kp_old.wav" startFrame="144000"
                         frameCount="48000" minRms="0.26" maxRms="0.33"/>
    <assert-audio-energy filename="ru_r4_kp_old.wav" startFrame="192000"
                         frameCount="48000" minRms="0.37" maxRms="0.44"/>
  </actions>

  <assertions>
    <assert-track-count equals="3"/>
  </assertions>

  <verify-undo/>

</SActionScript>
